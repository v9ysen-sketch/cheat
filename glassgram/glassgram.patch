@@ -0,0 +1,30 @@
+package org.telegram.messenger;
+
+/**
+ * GlassGram visual mod switches.
+ */
+public final class GlassConfig {
+
+    private GlassConfig() {
+    }
+
+    /** Draw user / chat avatars as rounded squares instead of circles. */
+    public static final boolean SQUARE_AVATARS = true;
+
+    /**
+     * Corner radius of a square avatar, as a fraction of the circle radius it replaces
+     * (1.0 = circle, 0.0 = sharp square).
+     */
+    public static final float AVATAR_CORNER = 0.32f;
+
+    public static int avatarRadius(int circleRadius) {
+        return SQUARE_AVATARS ? Math.round(circleRadius * AVATAR_CORNER) : circleRadius;
+    }
+
+    public static float avatarRadius(float circleRadius) {
+        return SQUARE_AVATARS ? circleRadius * AVATAR_CORNER : circleRadius;
+    }
+
+    /** Liquid glass and blurred panels are switched on once, on the first launch of GlassGram. */
+    public static final boolean FORCE_GLASS_ON_FIRST_LAUNCH = true;
+}
