--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/GlassPluginSettingsActivity.java
@@ -0,0 +1,217 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.AndroidUtilities.dp;
+import static org.telegram.messenger.LocaleController.getString;
+
+import android.content.Context;
+import android.text.InputType;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.FrameLayout;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.GlassPlugins;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.EditTextBoldCursor;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * GlassGram: settings screen of one plugin, built from its create_settings().
+ */
+public class GlassPluginSettingsActivity extends UniversalFragment {
+
+    private static final int ID_BASE = 100;
+
+    private final String pluginId;
+    private final String pluginName;
+    private List<GlassPlugins.SettingItem> settings = new ArrayList<>();
+
+    public GlassPluginSettingsActivity(String pluginId, String pluginName) {
+        this.pluginId = pluginId;
+        this.pluginName = pluginName;
+    }
+
+    @Override
+    protected CharSequence getTitle() {
+        return pluginName;
+    }
+
+    @Override
+    protected boolean useSimpleActionBar() {
+        return true;
+    }
+
+    @Override
+    public View createView(Context context) {
+        fragmentView = super.createView(context);
+        listView.setSections();
+        listView.setSectionsDrawBackground(true);
+        reload();
+        return fragmentView;
+    }
+
+    @Override
+    protected RecyclerListView getListViewForSimpleGlass() {
+        return listView;
+    }
+
+    private void reload() {
+        try {
+            settings = GlassPlugins.getEngine().getSettings(pluginId);
+        } catch (Throwable t) {
+            FileLog.e(t);
+            settings = new ArrayList<>();
+        }
+        if (listView != null && listView.adapter != null) {
+            listView.adapter.update(true);
+        }
+    }
+
+    private int icon(String name) {
+        if (TextUtils.isEmpty(name)) {
+            return 0;
+        }
+        try {
+            return getContext().getResources().getIdentifier(name, "drawable", getContext().getPackageName());
+        } catch (Exception e) {
+            return 0;
+        }
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        boolean needShadow = false;
+        for (GlassPlugins.SettingItem s : settings) {
+            final int id = ID_BASE + s.index;
+            final int iconRes = icon(s.icon);
+            switch (s.type) {
+                case GlassPlugins.SettingItem.HEADER:
+                    if (needShadow) {
+                        items.add(UItem.asShadow(null));
+                    }
+                    items.add(UItem.asHeader(s.text));
+                    needShadow = true;
+                    break;
+                case GlassPlugins.SettingItem.SWITCH:
+                    if (!TextUtils.isEmpty(s.subtext)) {
+                        items.add(UItem.asButtonCheck(id, s.text, s.subtext).setChecked(s.checked));
+                    } else {
+                        items.add(UItem.asCheck(id, s.text).setChecked(s.checked));
+                    }
+                    needShadow = true;
+                    break;
+                case GlassPlugins.SettingItem.INPUT:
+                    items.add(iconRes != 0 ? UItem.asButton(id, iconRes, s.text, s.value) : UItem.asButton(id, s.text, s.value));
+                    needShadow = true;
+                    break;
+                case GlassPlugins.SettingItem.SELECTOR: {
+                    final String value = s.items != null && s.selected >= 0 && s.selected < s.items.length ? s.items[s.selected] : "";
+                    items.add(iconRes != 0 ? UItem.asButton(id, iconRes, s.text, value) : UItem.asButton(id, s.text, value));
+                    needShadow = true;
+                    break;
+                }
+                case GlassPlugins.SettingItem.TEXT: {
+                    UItem item = iconRes != 0 ? UItem.asButton(id, iconRes, s.text) : UItem.asButton(id, s.text);
+                    if (s.red) {
+                        item = item.red();
+                    }
+                    items.add(item);
+                    if (!TextUtils.isEmpty(s.subtext)) {
+                        items.add(UItem.asShadow(s.subtext));
+                        needShadow = false;
+                    } else {
+                        needShadow = true;
+                    }
+                    break;
+                }
+                case GlassPlugins.SettingItem.DIVIDER:
+                    items.add(UItem.asShadow(s.text));
+                    needShadow = false;
+                    break;
+            }
+        }
+        if (needShadow) {
+            items.add(UItem.asShadow(null));
+        }
+    }
+
+    private GlassPlugins.SettingItem find(int id) {
+        final int index = id - ID_BASE;
+        for (GlassPlugins.SettingItem s : settings) {
+            if (s.index == index) {
+                return s;
+            }
+        }
+        return null;
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        final GlassPlugins.SettingItem s = find(item.id);
+        if (s == null) {
+            return;
+        }
+        final GlassPlugins.Engine engine = GlassPlugins.getEngine();
+        switch (s.type) {
+            case GlassPlugins.SettingItem.SWITCH:
+                engine.onSettingChanged(pluginId, s.index, !s.checked);
+                reload();
+                break;
+            case GlassPlugins.SettingItem.SELECTOR:
+                if (s.items == null) {
+                    return;
+                }
+                new AlertDialog.Builder(getContext(), getResourceProvider())
+                    .setTitle(s.text)
+                    .setItems(s.items, (d, which) -> {
+                        engine.onSettingChanged(pluginId, s.index, which);
+                        reload();
+                    })
+                    .show();
+                break;
+            case GlassPlugins.SettingItem.INPUT: {
+                final Context context = getContext();
+                final EditTextBoldCursor editText = new EditTextBoldCursor(context);
+                editText.setText(s.value == null ? "" : s.value);
+                editText.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, getResourceProvider()));
+                editText.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
+                editText.setLineColors(Theme.getColor(Theme.key_windowBackgroundWhiteInputField), Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated), Theme.getColor(Theme.key_text_RedRegular));
+                final FrameLayout container = new FrameLayout(context);
+                container.addView(editText, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 24, 0, 24, 0));
+                new AlertDialog.Builder(context, getResourceProvider())
+                    .setTitle(s.text)
+                    .setView(container)
+                    .setPositiveButton(getString(R.string.Save), (d, w) -> {
+                        engine.onSettingChanged(pluginId, s.index, editText.getText().toString());
+                        reload();
+                    })
+                    .setNegativeButton(getString(R.string.Cancel), null)
+                    .show();
+                AndroidUtilities.runOnUIThread(() -> {
+                    editText.requestFocus();
+                    AndroidUtilities.showKeyboard(editText);
+                }, 200);
+                break;
+            }
+            case GlassPlugins.SettingItem.TEXT:
+                engine.onSettingClicked(pluginId, s.index);
+                reload();
+                break;
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
