diff --git a/TMessagesProj_App/src/main/java/org/telegram/messenger/glass/GlassHookBridge.java b/TMessagesProj_App/src/main/java/org/telegram/messenger/glass/GlassHookBridge.java
new file mode 100644
index 0000000..b31ec4b
--- /dev/null
+++ b/TMessagesProj_App/src/main/java/org/telegram/messenger/glass/GlassHookBridge.java
@@ -0,0 +1,56 @@
+package org.telegram.messenger.glass;
+
+import java.lang.reflect.Member;
+
+import top.canyie.pine.Pine;
+import top.canyie.pine.PineConfig;
+import top.canyie.pine.callback.MethodHook;
+
+/**
+ * GlassGram: Xposed-style method hooks for plugins (hook_method in base_plugin.py), backed by Pine.
+ * The Pine call frame is handed to Python as the hook "param": it has thisObject, args, method,
+ * getResult()/setResult() and getThrowable()/setThrowable() like Xposed's MethodHookParam.
+ */
+public final class GlassHookBridge {
+
+    private GlassHookBridge() {
+    }
+
+    /** Implemented in Python with dynamic_proxy. */
+    public interface Callback {
+        void before(Pine.CallFrame param) throws Throwable;
+        void after(Pine.CallFrame param) throws Throwable;
+    }
+
+    private static boolean initialized;
+
+    private static synchronized void init() {
+        if (!initialized) {
+            PineConfig.debug = false;
+            PineConfig.debuggable = false;
+            Pine.ensureInitialized();
+            initialized = true;
+        }
+    }
+
+    public static MethodHook.Unhook hook(Member member, final Callback callback) {
+        init();
+        return Pine.hook(member, new MethodHook() {
+            @Override
+            public void beforeCall(Pine.CallFrame callFrame) throws Throwable {
+                callback.before(callFrame);
+            }
+
+            @Override
+            public void afterCall(Pine.CallFrame callFrame) throws Throwable {
+                callback.after(callFrame);
+            }
+        });
+    }
+
+    public static void unhook(Object unhook) {
+        if (unhook instanceof MethodHook.Unhook) {
+            ((MethodHook.Unhook) unhook).unhook();
+        }
+    }
+}
