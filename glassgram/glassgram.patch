+package org.telegram.ui;
+
+import static org.telegram.messenger.LocaleController.formatString;
+import static org.telegram.messenger.LocaleController.getString;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.text.TextUtils;
+import android.view.View;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.GlassConfig;
+import org.telegram.messenger.GlassPlugins;
+import org.telegram.messenger.R;
+import org.telegram.messenger.Utilities;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * GlassGram: list of installed plugins (exteraGram .plugin files).
+ */
+public class GlassPluginsActivity extends UniversalFragment {
+
+    private static final int ID_ENABLE = 1;
+    private static final int ID_INSTALL = 2;
+    private static final int ID_PLUGIN_BASE = 1000;
+    private static final int REQUEST_PICK = 4201;
+
+    private List<GlassPlugins.PluginInfo> plugins = new ArrayList<>();
+    private boolean loading;
+
+    @Override
+    protected CharSequence getTitle() {
+        return getString(R.string.GlassPlugins);
+    }
+
+    @Override
+    protected boolean useSimpleActionBar() {
+        return true;
+    }
+
+    @Override
+    public View createView(Context context) {
+        fragmentView = super.createView(context);
+        listView.setSections();
+        listView.setSectionsDrawBackground(true);
+        reload();
+        return fragmentView;
+    }
+
+    @Override
+    protected RecyclerListView getListViewForSimpleGlass() {
+        return listView;
+    }
+
+    private void reload() {
+        if (!GlassPlugins.isAvailable() || !GlassConfig.pluginsEnabled()) {
+            return;
+        }
+        loading = true;
+        Utilities.globalQueue.postRunnable(() -> {
+            final List<GlassPlugins.PluginInfo> list = GlassPlugins.list();
+            AndroidUtilities.runOnUIThread(() -> {
+                plugins = list;
+                loading = false;
+                if (listView != null && listView.adapter != null) {
+                    listView.adapter.update(true);
+                }
+            });
+        });
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asCheck(ID_ENABLE, getString(R.string.GlassPluginsEnable)).setChecked(GlassConfig.pluginsEnabled()));
+        items.add(UItem.asShadow(getString(R.string.GlassPluginsWarning)));
+        if (!GlassPlugins.isAvailable()) {
+            items.add(UItem.asShadow(getString(R.string.GlassPluginsUnavailable)));
+            return;
+        }
+        if (!GlassConfig.pluginsEnabled()) {
+            return;
+        }
+        items.add(UItem.asButton(ID_INSTALL, R.drawable.msg_add, getString(R.string.GlassPluginsInstall)).accent());
+        items.add(UItem.asShadow(getString(R.string.GlassPluginsInstallInfo)));
+
+        if (!plugins.isEmpty()) {
+            items.add(UItem.asHeader(getString(R.string.GlassPluginsInstalled)));
+            for (int i = 0; i < plugins.size(); i++) {
+                final GlassPlugins.PluginInfo p = plugins.get(i);
+                final StringBuilder sub = new StringBuilder();
+                if (p.error != null) {
+                    sub.append(getString(R.string.GlassPluginError)).append(": ").append(firstLine(p.error));
+                } else {
+                    if (!TextUtils.isEmpty(p.version)) {
+                        sub.append("v").append(p.version);
+                    }
+                    if (!TextUtils.isEmpty(p.author)) {
+                        if (sub.length() > 0) sub.append(" · ");
+                        sub.append(p.author);
+                    }
+                    if (!TextUtils.isEmpty(p.description)) {
+                        if (sub.length() > 0) sub.append(" · ");
+                        sub.append(firstLine(p.description));
+                    }
+                }
+                items.add(UItem.asButtonCheck(ID_PLUGIN_BASE + i, p.name, sub).setChecked(p.enabled));
+            }
+            items.add(UItem.asShadow(getString(R.string.GlassPluginsLongTap)));
+        } else if (!loading) {
+            items.add(UItem.asShadow(getString(R.string.GlassPluginsEmpty)));
+        }
+    }
+
+    private static String firstLine(String s) {
+        final String t = s.trim();
+        final int n = t.lastIndexOf('\n');
+        String line = n >= 0 && t.startsWith("Traceback") ? t.substring(n + 1) : t.split("\n")[0];
+        return line.length() > 120 ? line.substring(0, 120) + "…" : line;
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == ID_ENABLE) {
+            GlassConfig.setPluginsEnabled(!GlassConfig.pluginsEnabled());
+            listView.adapter.update(true);
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.info, getString(R.string.GlassRestartNeeded), getString(R.string.GlassRestart), 5000, GlassSettingsActivity::restartApp).show();
+        } else if (item.id == ID_INSTALL) {
+            final Intent intent = new Intent(Intent.ACTION_GET_CONTENT);
+            intent.setType("*/*");
+            intent.addCategory(Intent.CATEGORY_OPENABLE);
+            try {
+                startActivityForResult(Intent.createChooser(intent, getString(R.string.GlassPluginsInstall)), REQUEST_PICK);
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+        } else if (item.id >= ID_PLUGIN_BASE && item.id - ID_PLUGIN_BASE < plugins.size()) {
+            final GlassPlugins.PluginInfo p = plugins.get(item.id - ID_PLUGIN_BASE);
+            final boolean enable = !p.enabled;
+            Utilities.globalQueue.postRunnable(() -> {
+                try {
+                    GlassPlugins.getEngine().setEnabled(p.id, enable);
+                } catch (Throwable t) {
+                    FileLog.e(t);
+                }
+                reload();
+            });
+        }
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        if (item.id < ID_PLUGIN_BASE || item.id - ID_PLUGIN_BASE >= plugins.size()) {
+            return false;
+        }
+        final GlassPlugins.PluginInfo p = plugins.get(item.id - ID_PLUGIN_BASE);
+        final ArrayList<CharSequence> options = new ArrayList<>();
+        final ArrayList<Integer> actions = new ArrayList<>();
+        if (p.enabled && p.error == null && p.hasSettings) {
+            options.add(getString(R.string.GlassPluginSettings));
+            actions.add(0);
+        }
+        options.add(getString(R.string.GlassPluginInfo));
+        actions.add(1);
+        options.add(getString(R.string.GlassPluginDelete));
+        actions.add(2);
+        new AlertDialog.Builder(getContext(), getResourceProvider())
+            .setTitle(p.name)
+            .setItems(options.toArray(new CharSequence[0]), (d, which) -> {
+                final int action = actions.get(which);
+                if (action == 0) {
+                    presentFragment(new GlassPluginSettingsActivity(p.id, p.name));
+                } else if (action == 1) {
+                    showInfo(p);
+                } else {
+                    confirmDelete(p);
+                }
+            })
+            .show();
+        return true;
+    }
+
+    private void showInfo(GlassPlugins.PluginInfo p) {
+        final StringBuilder text = new StringBuilder();
+        text.append("id: ").append(p.id).append('\n');
+        if (!TextUtils.isEmpty(p.version)) text.append("version: ").append(p.version).append('\n');
+        if (!TextUtils.isEmpty(p.author)) text.append("author: ").append(p.author).append('\n');
+        if (!TextUtils.isEmpty(p.description)) text.append('\n').append(p.description).append('\n');
+        if (p.error != null) text.append('\n').append(p.error);
+        new AlertDialog.Builder(getContext(), getResourceProvider())
+            .setTitle(p.name)
+            .setMessage(text.toString().trim())
+            .setPositiveButton(getString(R.string.OK), null)
+            .show();
+    }
+
+    private void confirmDelete(GlassPlugins.PluginInfo p) {
+        new AlertDialog.Builder(getContext(), getResourceProvider())
+            .setTitle(getString(R.string.GlassPluginDelete))
+            .setMessage(formatString(R.string.GlassPluginDeleteConfirm, p.name))
+            .setPositiveButton(getString(R.string.Delete), (d, w) -> Utilities.globalQueue.postRunnable(() -> {
+                try {
+                    GlassPlugins.getEngine().delete(p.id);
+                } catch (Throwable t) {
+                    FileLog.e(t);
+                }
+                reload();
+            }))
+            .setNegativeButton(getString(R.string.Cancel), null)
+            .makeRed(AlertDialog.BUTTON_POSITIVE)
+            .show();
+    }
+
+    @Override
+    public void onActivityResultFragment(int requestCode, int resultCode, Intent data) {
+        if (requestCode != REQUEST_PICK || resultCode != Activity.RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        final Uri uri = data.getData();
+        Utilities.globalQueue.postRunnable(() -> {
+            final File tmp = new File(ApplicationLoader.applicationContext.getCacheDir(), "import.plugin");
+            try (InputStream in = ApplicationLoader.applicationContext.getContentResolver().openInputStream(uri);
+                 OutputStream out = new FileOutputStream(tmp)) {
+                final byte[] buffer = new byte[16384];
+                int n;
+                long total = 0;
+                while ((n = in.read(buffer)) > 0) {
+                    total += n;
+                    if (total > 4 * 1024 * 1024) {
+                        throw new IllegalArgumentException("file is too large");
+                    }
+                    out.write(buffer, 0, n);
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+                AndroidUtilities.runOnUIThread(() -> BulletinFactory.of(this).createErrorBulletin(e.getMessage() == null ? "error" : e.getMessage()).show());
+                return;
+            }
+            installFile(this, tmp, this::reload);
+        });
+    }
+
+    /** Installs a plugin file on a background thread and shows the result. */
+    public static void installFile(BaseFragment fragment, File file, Runnable after) {
+        Utilities.globalQueue.postRunnable(() -> {
+            String id = null;
+            String error = null;
+            try {
+                id = GlassPlugins.getEngine().install(file);
+            } catch (Throwable t) {
+                FileLog.e(t);
+                error = t.getMessage();
+                if (error != null && error.contains("\n")) {
+                    final String[] lines = error.trim().split("\n");
+                    error = lines[lines.length - 1];
+                }
+            }
+            final String finalId = id;
+            final String finalError = error;
+            AndroidUtilities.runOnUIThread(() -> {
+                final BulletinFactory factory = fragment != null ? BulletinFactory.of(fragment) : BulletinFactory.global();
+                if (finalId != null) {
+                    factory.createSimpleBulletin(R.raw.contact_check, formatString(R.string.GlassPluginInstalled, finalId)).show();
+                } else {
+                    factory.createErrorBulletin(getString(R.string.GlassPluginInstallFailed) + (finalError != null ? ": " + finalError : "")).show();
+                }
+                if (after != null) {
+                    after.run();
+                }
+            });
+        });
+    }
+
+    /** Called when a .plugin document is opened in a chat. */
+    public static boolean offerInstall(Activity activity, File file, String fileName) {
+        if (activity == null || file == null || !file.exists() || !GlassPlugins.isAvailable() || !GlassConfig.pluginsEnabled()) {
+            return false;
+        }
+        new AlertDialog.Builder(activity)
+            .setTitle(getString(R.string.GlassPluginsInstall))
+            .setMessage(formatString(R.string.GlassPluginInstallConfirm, fileName))
+            .setPositiveButton(getString(R.string.GlassPluginInstallButton), (d, w) -> installFile(LaunchActivity.getLastFragment(), file, null))
+            .setNegativeButton(getString(R.string.Cancel), null)
+            .show();
+        return true;
+    }
+}
