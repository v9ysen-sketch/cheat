+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.GlassPlugins;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * GlassGram: runs plugins in embedded Python (Chaquopy). The plugin API itself (base_plugin, client_utils, ...)
+ * is written in Python, see src/main/python; glass_engine.py is the entry point used here.
+ */
+public class GlassPythonEngine implements GlassPlugins.Engine {
+
+    public static final int KIND_REQUEST = 0;
+    public static final int KIND_UPDATE = 1;
+    public static final int KIND_UPDATES = 2;
+
+    private final Context context;
+    private final File pluginsDir;
+    private volatile PyObject module;
+
+    /** hook name -> match as substring; filled by the Python side. */
+    private final Map<String, Boolean>[] hookNames = new Map[]{new ConcurrentHashMap<>(), new ConcurrentHashMap<>(), new ConcurrentHashMap<>()};
+    private volatile int sendMessageHookCount;
+
+    public GlassPythonEngine(Context context) {
+        this.context = context.getApplicationContext();
+        this.pluginsDir = new File(context.getFilesDir(), "plugins");
+    }
+
+    private synchronized PyObject module() {
+        if (module == null) {
+            if (!Python.isStarted()) {
+                Python.start(new AndroidPlatform(context));
+            }
+            final PyObject m = Python.getInstance().getModule("glass_engine");
+            m.callAttr("init", pluginsDir.getAbsolutePath(), this);
+            module = m;
+        }
+        return module;
+    }
+
+    // --- called from Python ---
+
+    public void registerHook(int kind, String name, boolean substring) {
+        hookNames[kind].put(name, substring);
+        updateFlags();
+    }
+
+    public void clearHooks() {
+        for (Map<String, Boolean> m : hookNames) {
+            m.clear();
+        }
+        sendMessageHookCount = 0;
+        updateFlags();
+    }
+
+    public void setSendMessageHookCount(int count) {
+        sendMessageHookCount = count;
+        updateFlags();
+    }
+
+    private void updateFlags() {
+        GlassPlugins.requestHooks = !hookNames[KIND_REQUEST].isEmpty();
+        GlassPlugins.updateHooks = !hookNames[KIND_UPDATE].isEmpty() || !hookNames[KIND_UPDATES].isEmpty();
+        GlassPlugins.sendMessageHooks = sendMessageHookCount > 0;
+    }
+
+    private boolean matches(int kind, String name) {
+        final Map<String, Boolean> m = hookNames[kind];
+        if (m.isEmpty() || name == null) {
+            return false;
+        }
+        if (m.containsKey(name)) {
+            return true;
+        }
+        for (Map.Entry<String, Boolean> e : m.entrySet()) {
+            if (e.getValue() && name.contains(e.getKey())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // --- GlassPlugins.Engine ---
+
+    @Override
+    public void start() {
+        // no plugins installed: do not start Python until the plugins screen is opened
+        final String[] files = pluginsDir.list((dir, name) -> name.endsWith(".py"));
+        if (files == null || files.length == 0) {
+            return;
+        }
+        module().callAttr("load_all");
+    }
+
+    @Override
+    public List<GlassPlugins.PluginInfo> list() {
+        final ArrayList<GlassPlugins.PluginInfo> result = new ArrayList<>();
+        try {
+            final JSONArray array = new JSONArray(module().callAttr("list_plugins").toString());
+            for (int i = 0; i < array.length(); i++) {
+                final JSONObject o = array.getJSONObject(i);
+                final GlassPlugins.PluginInfo info = new GlassPlugins.PluginInfo();
+                info.id = o.optString("id");
+                info.name = o.optString("name", info.id);
+                info.description = o.optString("description", "");
+                info.author = o.optString("author", "");
+                info.version = o.optString("version", "");
+                info.icon = o.optString("icon", "");
+                info.enabled = o.optBoolean("enabled");
+                info.hasSettings = o.optBoolean("has_settings");
+                info.error = o.isNull("error") ? null : o.optString("error", null);
+                result.add(info);
+            }
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+        return result;
+    }
+
+    @Override
+    public void setEnabled(String id, boolean enabled) {
+        module().callAttr("set_enabled", id, enabled);
+    }
+
+    @Override
+    public String install(File file) throws Exception {
+        return module().callAttr("install", file.getAbsolutePath()).toString();
+    }
+
+    @Override
+    public void delete(String id) {
+        module().callAttr("delete", id);
+    }
+
+    @Override
+    public List<GlassPlugins.SettingItem> getSettings(String id) {
+        final ArrayList<GlassPlugins.SettingItem> result = new ArrayList<>();
+        try {
+            final JSONArray array = new JSONArray(module().callAttr("get_settings", id).toString());
+            for (int i = 0; i < array.length(); i++) {
+                final JSONObject o = array.getJSONObject(i);
+                final GlassPlugins.SettingItem item = new GlassPlugins.SettingItem();
+                item.index = i;
+                item.type = o.optInt("type");
+                item.key = o.optString("key", null);
+                item.text = o.optString("text", "");
+                item.subtext = o.isNull("subtext") ? null : o.optString("subtext", null);
+                item.icon = o.isNull("icon") ? null : o.optString("icon", null);
+                item.checked = o.optBoolean("checked");
+                item.value = o.isNull("value") ? null : o.optString("value", null);
+                item.selected = o.optInt("selected");
+                item.red = o.optBoolean("red");
+                final JSONArray items = o.optJSONArray("items");
+                if (items != null) {
+                    item.items = new String[items.length()];
+                    for (int k = 0; k < items.length(); k++) {
+                        item.items[k] = items.optString(k);
+                    }
+                }
+                result.add(item);
+            }
+        } catch (Throwable t) {
+            FileLog.e(t);
+        }
+        return result;
+    }
+
+    @Override
+    public void onSettingChanged(String id, int index, Object value) {
+        module().callAttr("setting_changed", id, index, value);
+    }
+
+    @Override
+    public void onSettingClicked(String id, int index) {
+        module().callAttr("setting_clicked", id, index);
+    }
+
+    // --- hooks ---
+
+    @Override
+    public TLObject preRequest(int account, TLObject request) {
+        final String name = request.getClass().getSimpleName();
+        if (!matches(KIND_REQUEST, name)) {
+            return request;
+        }
+        final PyObject r = module().callAttr("pre_request", name, account, request);
+        if (r == null) {
+            return request;
+        }
+        final Object[] res = r.toJava(Object[].class);
+        if (res[0] instanceof Boolean && (Boolean) res[0]) {
+            return null; // cancelled
+        }
+        return res[1] instanceof TLObject ? (TLObject) res[1] : request;
+    }
+
+    @Override
+    public Object[] postRequest(int account, TLObject request, TLObject response, TLRPC.TL_error error) {
+        final String name = request.getClass().getSimpleName();
+        if (!matches(KIND_REQUEST, name)) {
+            return null;
+        }
+        final PyObject r = module().callAttr("post_request", name, account, response, error);
+        return r == null ? null : r.toJava(Object[].class);
+    }
+
+    @Override
+    public boolean onSendMessage(int account, SendMessagesHelper.SendMessageParams params) {
+        if (sendMessageHookCount <= 0) {
+            return false;
+        }
+        final PyObject r = module().callAttr("send_message", account, params);
+        return r != null && r.toBoolean();
+    }
+
+    @Override
+    public boolean onUpdate(int account, TLRPC.Update update) {
+        final String name = update.getClass().getSimpleName();
+        if (!matches(KIND_UPDATE, name)) {
+            return false;
+        }
+        final PyObject r = module().callAttr("on_update", name, account, update);
+        return r != null && r.toBoolean();
+    }
+
+    @Override
+    public void onUpdates(int account, TLRPC.Updates updates) {
+        final String name = updates.getClass().getSimpleName();
+        if (matches(KIND_UPDATES, name)) {
+            module().callAttr("on_updates", name, account, updates);
+        }
+    }
+
+    public static List<String> emptyList() {
+        return Collections.emptyList();
+    }
+}
