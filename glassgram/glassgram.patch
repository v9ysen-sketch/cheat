@@ -0,0 +1,170 @@
+"""GlassGram plugin API: HTML / Markdown to Telegram entities (exteraGram extera_utils.text_formatting)."""
+
+import re
+from html.parser import HTMLParser
+
+from java import jclass
+
+_TLRPC = jclass("org.telegram.tgnet.TLRPC")
+_ArrayList = jclass("java.util.ArrayList")
+
+
+def _u16(s):
+    return len(s.encode("utf-16-le")) // 2
+
+
+class TLEntityType:
+    BOLD = "bold"
+    ITALIC = "italic"
+    UNDERLINE = "underline"
+    STRIKETHROUGH = "strikethrough"
+    SPOILER = "spoiler"
+    CODE = "code"
+    PRE = "pre"
+    TEXT_LINK = "text_link"
+    BLOCKQUOTE = "blockquote"
+    CUSTOM_EMOJI = "custom_emoji"
+
+
+class RawEntity:
+    def __init__(self, type, offset, length, url=None, language=None, document_id=None, collapsed=False):
+        self.type = type
+        self.offset = offset
+        self.length = length
+        self.url = url
+        self.language = language
+        self.document_id = document_id
+        self.collapsed = collapsed
+
+    def to_tlrpc_object(self):
+        t = self.type
+        if t == TLEntityType.BOLD:
+            e = _TLRPC.TL_messageEntityBold()
+        elif t == TLEntityType.ITALIC:
+            e = _TLRPC.TL_messageEntityItalic()
+        elif t == TLEntityType.UNDERLINE:
+            e = _TLRPC.TL_messageEntityUnderline()
+        elif t == TLEntityType.STRIKETHROUGH:
+            e = _TLRPC.TL_messageEntityStrike()
+        elif t == TLEntityType.SPOILER:
+            e = _TLRPC.TL_messageEntitySpoiler()
+        elif t == TLEntityType.CODE:
+            e = _TLRPC.TL_messageEntityCode()
+        elif t == TLEntityType.PRE:
+            e = _TLRPC.TL_messageEntityPre()
+            e.language = self.language or ""
+        elif t == TLEntityType.TEXT_LINK:
+            e = _TLRPC.TL_messageEntityTextUrl()
+            e.url = self.url or ""
+        elif t == TLEntityType.BLOCKQUOTE:
+            e = _TLRPC.TL_messageEntityBlockquote()
+            e.collapsed = bool(self.collapsed)
+        elif t == TLEntityType.CUSTOM_EMOJI:
+            e = _TLRPC.TL_messageEntityCustomEmoji()
+            e.document_id = int(self.document_id or 0)
+        else:
+            return None
+        e.offset = int(self.offset)
+        e.length = int(self.length)
+        return e
+
+
+class _Html(HTMLParser):
+    TAGS = {"b": TLEntityType.BOLD, "strong": TLEntityType.BOLD, "i": TLEntityType.ITALIC, "em": TLEntityType.ITALIC,
+            "u": TLEntityType.UNDERLINE, "ins": TLEntityType.UNDERLINE, "s": TLEntityType.STRIKETHROUGH,
+            "del": TLEntityType.STRIKETHROUGH, "strike": TLEntityType.STRIKETHROUGH, "code": TLEntityType.CODE,
+            "pre": TLEntityType.PRE, "a": TLEntityType.TEXT_LINK, "spoiler": TLEntityType.SPOILER,
+            "tg-spoiler": TLEntityType.SPOILER, "blockquote": TLEntityType.BLOCKQUOTE, "emoji": TLEntityType.CUSTOM_EMOJI,
+            "tg-emoji": TLEntityType.CUSTOM_EMOJI}
+
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.text = ""
+        self.stack = []
+        self.entities = []
+
+    def handle_starttag(self, tag, attrs):
+        a = dict(attrs)
+        t = self.TAGS.get(tag)
+        if tag == "span" and "tg-spoiler" in (a.get("class") or ""):
+            t = TLEntityType.SPOILER
+        if tag == "br":
+            self.text += "\n"
+            return
+        if t is None:
+            return
+        if t == TLEntityType.CODE and self.stack and self.stack[-1][0] == TLEntityType.PRE:
+            lang = (a.get("class") or "").replace("language-", "")
+            self.stack[-1][2]["language"] = lang
+            self.stack.append((None, _u16(self.text), {}))
+            return
+        extra = {"url": a.get("href"), "language": a.get("language"),
+                 "document_id": a.get("id") or a.get("emoji-id"), "collapsed": "expandable" in a}
+        self.stack.append((t, _u16(self.text), extra))
+
+    def handle_endtag(self, tag):
+        if not self.stack:
+            return
+        t, start, extra = self.stack.pop()
+        if t is None:
+            return
+        length = _u16(self.text) - start
+        if length > 0:
+            self.entities.append(RawEntity(t, start, length, extra.get("url"), extra.get("language"),
+                                           extra.get("document_id"), extra.get("collapsed")))
+
+    def handle_data(self, data):
+        self.text += data
+
+
+_MD = re.compile(
+    r"```(?P<lang>\w*)\n?(?P<pre>.*?)```"
+    r"|`(?P<code>[^`]+)`"
+    r"|\[(?P<ltext>[^\]]+)\]\((?P<url>[^)]+)\)"
+    r"|\*\*(?P<bold2>.+?)\*\*"
+    r"|__(?P<under>.+?)__"
+    r"|\|\|(?P<spoiler>.+?)\|\|"
+    r"|~~?(?P<strike>[^~]+?)~~?"
+    r"|(?<![\w*])\*(?P<bold>[^\s*](?:.*?[^\s*])?)\*(?![\w*])"
+    r"|(?<![\w_])_(?P<italic>[^\s_](?:.*?[^\s_])?)_(?![\w_])",
+    re.S)
+
+_MD_TYPES = {"pre": TLEntityType.PRE, "code": TLEntityType.CODE, "ltext": TLEntityType.TEXT_LINK,
+             "bold2": TLEntityType.BOLD, "under": TLEntityType.UNDERLINE, "spoiler": TLEntityType.SPOILER,
+             "strike": TLEntityType.STRIKETHROUGH, "bold": TLEntityType.BOLD, "italic": TLEntityType.ITALIC}
+
+
+def _parse_markdown(text):
+    """Markdown with one level of formatting (entities do not nest)."""
+    out = ""
+    entities = []
+    pos = 0
+    for m in _MD.finditer(text):
+        out += text[pos:m.start()]
+        group = next(g for g in _MD_TYPES if m.group(g) is not None)
+        inner = m.group(group)
+        entities.append(RawEntity(_MD_TYPES[group], _u16(out), _u16(inner),
+                                  url=m.group("url") if group == "ltext" else None,
+                                  language=m.group("lang") if group == "pre" else None))
+        out += inner
+        pos = m.end()
+    out += text[pos:]
+    return out, [e for e in entities if e.length > 0]
+
+
+def parse_text(text, parse_mode="HTML", is_caption=False):
+    if parse_mode and parse_mode.upper() == "HTML":
+        p = _Html()
+        p.feed(text)
+        p.close()
+        plain, raw = p.text, p.entities
+    elif parse_mode and parse_mode.lower() == "markdown":
+        plain, raw = _parse_markdown(text)
+    else:
+        raise ValueError("unsupported parse_mode: %r" % parse_mode)
+    entities = _ArrayList()
+    for e in raw:
+        o = e.to_tlrpc_object()
+        if o is not None:
+            entities.add(o)
+    return {"caption" if is_caption else "message": plain, "entities": entities}
diff --git a/TMessagesProj_App/src/main/python/file_utils.py b/TMessagesProj_App/src/main/python/file_utils.py
