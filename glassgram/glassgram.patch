@@ -0,0 +1,70 @@
+"""GlassGram plugin API: bulletins (exteraGram ui.bulletin)."""
+
+from java import jclass
+
+from android_utils import run_on_ui_thread
+
+_BulletinFactory = jclass("org.telegram.ui.Components.BulletinFactory")
+_Bulletin = jclass("org.telegram.ui.Components.Bulletin")
+_R = jclass("org.telegram.messenger.R")
+
+
+def _factory(fragment):
+    if fragment is None:
+        from client_utils import get_last_fragment
+        fragment = get_last_fragment()
+    if fragment is not None:
+        return _BulletinFactory.of(fragment)
+    return _BulletinFactory.global_()
+
+
+class BulletinHelper:
+    DURATION_SHORT = 1500
+    DURATION_LONG = 2750
+    DURATION_PROLONG = 5000
+
+    @classmethod
+    def show_simple(cls, text, icon_res_id, fragment=None):
+        run_on_ui_thread(lambda: _factory(fragment).createSimpleBulletin(int(icon_res_id), str(text)).show())
+
+    @classmethod
+    def show_info(cls, message, fragment=None):
+        cls.show_simple(message, _R.raw.info, fragment)
+
+    @classmethod
+    def show_error(cls, message, fragment=None):
+        cls.show_simple(message, _R.raw.error, fragment)
+
+    @classmethod
+    def show_success(cls, message, fragment=None):
+        cls.show_simple(message, _R.raw.contact_check, fragment)
+
+    @classmethod
+    def show_two_line(cls, title, subtitle, icon_res_id, fragment=None):
+        run_on_ui_thread(lambda: _factory(fragment).createSimpleBulletin(int(icon_res_id), str(title), str(subtitle)).show())
+
+    @classmethod
+    def show_with_button(cls, text, icon_res_id, button_text, on_click, fragment=None, duration=DURATION_PROLONG):
+        from android_utils import R
+        run_on_ui_thread(lambda: _factory(fragment).createSimpleBulletin(int(icon_res_id), str(text), str(button_text), int(duration), R(on_click)).show())
+
+    @classmethod
+    def show_undo(cls, text, on_undo, on_action=None, subtitle=None, fragment=None):
+        from android_utils import R
+        run_on_ui_thread(lambda: _factory(fragment).createUndoBulletin(str(text), R(on_undo), R(on_action or (lambda: None))).show())
+
+    @classmethod
+    def show_copied_to_clipboard(cls, message=None, fragment=None):
+        cls.show_simple(message or "Copied", _R.raw.copy, fragment)
+
+    @classmethod
+    def show_link_copied(cls, is_private_link_info=False):
+        cls.show_simple("Link copied", _R.raw.voip_invite, None)
+
+    @classmethod
+    def show_file_saved_to_gallery(cls, is_video=False, amount=1):
+        cls.show_simple("Saved to gallery", _R.raw.ic_download, None)
+
+    @classmethod
+    def show_file_saved_to_downloads(cls, file_type_enum_name="UNKNOWN", amount=1):
+        cls.show_simple("Saved to downloads", _R.raw.ic_download, None)
diff --git a/TMessagesProj_App/src/main/python/ui/settings.py b/TMessagesProj_App/src/main/python/ui/settings.py
