new file mode 100644
index 0000000..fabc929
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/hook_utils.py
@@ -0,0 +1,78 @@
+"""GlassGram plugin API: reflection helpers (exteraGram hook_utils)."""
+
+from java import jclass
+
+_Class = jclass("java.lang.Class")
+
+
+def _loader():
+    return jclass("org.telegram.messenger.ApplicationLoader").getClassLoader() if False else \
+        _Class.forName("org.telegram.messenger.ApplicationLoader").getClassLoader()
+
+
+def find_class(name):
+    """Returns java.lang.Class for the name, or None."""
+    try:
+        return _Class.forName(name, True, _loader())
+    except Exception:
+        return None
+
+
+def _as_class(obj):
+    if obj is None:
+        return None
+    if isinstance(obj, type):  # jclass proxy
+        try:
+            return _Class.forName(obj.__name__ if "." in obj.__name__ else obj.getClass().getName())
+        except Exception:
+            pass
+    return obj.getClass()
+
+
+def _find_field(clazz, name):
+    while clazz is not None:
+        try:
+            f = clazz.getDeclaredField(name)
+            f.setAccessible(True)
+            return f
+        except Exception:
+            clazz = clazz.getSuperclass()
+    return None
+
+
+def get_private_field(obj, name):
+    try:
+        f = _find_field(obj.getClass(), name)
+        return f.get(obj) if f is not None else None
+    except Exception:
+        return None
+
+
+def set_private_field(obj, name, value):
+    try:
+        f = _find_field(obj.getClass(), name)
+        if f is None:
+            return False
+        f.set(obj, value)
+        return True
+    except Exception:
+        return False
+
+
+def get_static_private_field(clazz, name):
+    try:
+        f = _find_field(clazz, name)
+        return f.get(None) if f is not None else None
+    except Exception:
+        return None
+
+
+def set_static_private_field(clazz, name, value):
+    try:
+        f = _find_field(clazz, name)
+        if f is None:
+            return False
+        f.set(None, value)
+        return True
+    except Exception:
+        return False
