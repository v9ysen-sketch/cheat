@@ -0,0 +1,124 @@
+"""GlassGram plugin API: dialogs (exteraGram ui.alert)."""
+
+from java import dynamic_proxy, jclass
+
+_AlertDialog = jclass("org.telegram.ui.ActionBar.AlertDialog")
+_DialogInterface = jclass("android.content.DialogInterface")
+
+
+class _ButtonListener(dynamic_proxy(_AlertDialog.OnButtonClickListener)):
+    def __init__(self, builder, fn):
+        super().__init__()
+        self.builder = builder
+        self.fn = fn
+
+    def onClick(self, dialog, which):
+        if self.fn:
+            self.fn(self.builder, which)
+
+
+class _ItemsListener(dynamic_proxy(_DialogInterface.OnClickListener)):
+    def __init__(self, builder, fn):
+        super().__init__()
+        self.builder = builder
+        self.fn = fn
+
+    def onClick(self, dialog, which):
+        if self.fn:
+            self.fn(self.builder, which)
+
+
+class _DismissListener(dynamic_proxy(_DialogInterface.OnDismissListener)):
+    def __init__(self, builder, fn):
+        super().__init__()
+        self.builder = builder
+        self.fn = fn
+
+    def onDismiss(self, dialog):
+        if self.fn:
+            self.fn(self.builder)
+
+
+class AlertDialogBuilder:
+    ALERT_TYPE_MESSAGE = 0
+    ALERT_TYPE_LOADING = 2
+    ALERT_TYPE_SPINNER = 3
+    BUTTON_POSITIVE = -1
+    BUTTON_NEGATIVE = -2
+    BUTTON_NEUTRAL = -3
+
+    def __init__(self, context, progress_style=ALERT_TYPE_MESSAGE, resources_provider=None):
+        self._builder = _AlertDialog.Builder(context, int(progress_style), resources_provider)
+        self._dialog = None
+
+    def set_title(self, title):
+        self._builder.setTitle(str(title))
+        return self
+
+    def set_message(self, message):
+        self._builder.setMessage(message)
+        return self
+
+    def set_view(self, view, height=-2):
+        self._builder.setView(view)
+        return self
+
+    def set_items(self, items, listener=None, icons=None):
+        arr = [str(x) for x in items]
+        self._builder.setItems(arr, _ItemsListener(self, listener))
+        return self
+
+    def set_positive_button(self, text, listener=None):
+        self._builder.setPositiveButton(str(text), _ButtonListener(self, listener))
+        return self
+
+    def set_negative_button(self, text, listener=None):
+        self._builder.setNegativeButton(str(text), _ButtonListener(self, listener))
+        return self
+
+    def set_neutral_button(self, text, listener=None):
+        self._builder.setNeutralButton(str(text), _ButtonListener(self, listener))
+        return self
+
+    def make_button_red(self, button_type=BUTTON_NEGATIVE):
+        self._builder.makeRed(int(button_type))
+        return self
+
+    def set_on_dismiss_listener(self, listener):
+        self._builder.setOnDismissListener(_DismissListener(self, listener))
+        return self
+
+    def set_cancelable(self, cancelable):
+        self._cancelable = bool(cancelable)
+        return self
+
+    def set_canceled_on_touch_outside(self, value):
+        self._outside = bool(value)
+        return self
+
+    def create(self):
+        if self._dialog is None:
+            self._dialog = self._builder.create()
+            if getattr(self, "_cancelable", None) is not None:
+                self._dialog.setCancelable(self._cancelable)
+            if getattr(self, "_outside", None) is not None:
+                self._dialog.setCanceledOnTouchOutside(self._outside)
+        return self._dialog
+
+    def show(self):
+        self.create().show()
+        return self
+
+    def dismiss(self):
+        if self._dialog is not None:
+            self._dialog.dismiss()
+
+    def get_dialog(self):
+        return self._dialog
+
+    def get_button(self, button_type):
+        return self._dialog.getButton(int(button_type)) if self._dialog is not None else None
+
+    def set_progress(self, progress):
+        if self._dialog is not None:
+            self._dialog.setProgress(int(progress))
