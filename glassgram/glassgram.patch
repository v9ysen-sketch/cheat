index 0000000..6fdca42
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/file_utils.py
@@ -0,0 +1,93 @@
+"""GlassGram plugin API: file helpers (exteraGram file_utils)."""
+
+import os
+
+from java import jclass
+
+_ApplicationLoader = jclass("org.telegram.messenger.ApplicationLoader")
+
+
+def _ctx():
+    return _ApplicationLoader.applicationContext
+
+
+def get_files_dir():
+    return _ctx().getFilesDir().getAbsolutePath()
+
+
+def get_cache_dir():
+    return _ctx().getCacheDir().getAbsolutePath()
+
+
+def get_plugins_dir():
+    return os.path.join(get_files_dir(), "plugins")
+
+
+def _sub(name):
+    path = os.path.join(get_files_dir(), name)
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def get_images_dir():
+    return _sub("images")
+
+
+def get_videos_dir():
+    return _sub("videos")
+
+
+def get_audios_dir():
+    return _sub("audios")
+
+
+def get_documents_dir():
+    return _sub("documents")
+
+
+def ensure_dir_exists(path):
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def list_dir(path, recursive=False, include_files=True, include_dirs=False, extensions=None):
+    result = []
+    exts = tuple(e if e.startswith(".") else "." + e for e in (extensions or []))
+    for root, dirs, files in os.walk(path):
+        if include_dirs:
+            result.extend(os.path.join(root, d) for d in dirs)
+        if include_files:
+            result.extend(os.path.join(root, f) for f in files if not exts or f.endswith(exts))
+        if not recursive:
+            break
+    return result
+
+
+def read_file(path, encoding="utf-8"):
+    with open(path, "r", encoding=encoding) as f:
+        return f.read()
+
+
+def write_file(path, content, encoding="utf-8"):
+    with open(path, "w", encoding=encoding) as f:
+        f.write(content)
+    return True
+
+
+def read_file_bytes(path):
+    with open(path, "rb") as f:
+        return f.read()
+
+
+def write_file_bytes(path, content):
+    with open(path, "wb") as f:
+        f.write(content)
+    return True
+
+
+def delete_file(path):
+    try:
+        os.remove(path)
+        return True
+    except OSError:
+        return False
diff --git a/TMessagesProj_App/src/main/python/glass_engine.py b/TMessagesProj_App/src/main/python/glass_engine.py
new file mode 100644
index 0000000..ebcc31c
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/glass_engine.py
@@ -0,0 +1,435 @@
+"""GlassGram plugin engine: loads .plugin files (exteraGram format) and dispatches hooks.
+
+Called from org.telegram.messenger.glass.GlassPythonEngine.
+"""
+
+import ast
+import importlib.util
+import json
+import os
+import re
+import shutil
+import sys
+import threading
+import traceback
+
+from java import jarray, jclass
+
+import base_plugin
+from base_plugin import BasePlugin, HookResult, HookStrategy
+
+_Log = jclass("android.util.Log")
+TAG = "GlassPlugins"
+
+KIND_REQUEST, KIND_UPDATE, KIND_UPDATES = 0, 1, 2
+ID_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]{1,31}$")
+
+_engine = None
+_dir = None
+_settings_dir = None
+_state_path = None
+_lock = threading.RLock()
+_plugins = {}   # id -> _Record
+_state = {}     # id -> enabled
+
+
+class _Record:
+    def __init__(self, plugin_id, path, meta):
+        self.id = plugin_id
+        self.path = path
+        self.meta = meta
+        self.instance = None
+        self.module = None
+        self.error = None
+        self.settings_items = []
+
+
+def _log(msg):
+    _Log.i(TAG, str(msg))
+
+
+def _err(msg):
+    _Log.e(TAG, str(msg))
+
+
+# --- setup ---
+
+def init(plugins_dir, engine):
+    global _engine, _dir, _settings_dir, _state_path, _state
+    _engine = engine
+    _dir = plugins_dir
+    _settings_dir = os.path.join(plugins_dir, "settings")
+    _state_path = os.path.join(plugins_dir, "state.json")
+    os.makedirs(_settings_dir, exist_ok=True)
+    try:
+        with open(_state_path, "r", encoding="utf-8") as f:
+            _state = json.load(f)
+    except Exception:
+        _state = {}
+    _scan()
+
+
+def _save_state():
+    try:
+        with open(_state_path, "w", encoding="utf-8") as f:
+            json.dump(_state, f)
+    except Exception:
+        _err(traceback.format_exc())
+
+
+def read_metadata(path):
+    with open(path, "r", encoding="utf-8") as f:
+        source = f.read()
+    tree = ast.parse(source, filename=path)
+    meta = {}
+    for node in tree.body:
+        if isinstance(node, ast.Assign):
+            for target in node.targets:
+                if isinstance(target, ast.Name) and target.id.startswith("__") and target.id.endswith("__"):
+                    try:
+                        meta[target.id.strip("_")] = ast.literal_eval(node.value)
+                    except Exception:
+                        pass
+    return meta
+
+
+def _scan():
+    with _lock:
+        for name in sorted(os.listdir(_dir)):
+            if not name.endswith(".py"):
+                continue
+            path = os.path.join(_dir, name)
+            plugin_id = name[:-3]
+            if plugin_id in _plugins:
+                continue
+            try:
+                meta = read_metadata(path)
+                rec = _Record(meta.get("id", plugin_id), path, meta)
+            except Exception:
+                rec = _Record(plugin_id, path, {"id": plugin_id, "name": plugin_id})
+                rec.error = "syntax error:\n" + traceback.format_exc(limit=1)
+            _plugins[rec.id] = rec
+
+
+def load_all():
+    with _lock:
+        for rec in list(_plugins.values()):
+            if _state.get(rec.id, True) and rec.instance is None and rec.error is None:
+                _load(rec)
+
+
+# --- loading ---
+
+def _check_requirements(meta):
+    reqs = meta.get("requirements") or []
+    if isinstance(reqs, str):
+        reqs = [reqs]
+    missing = []
+    for req in reqs:
+        name = re.split(r"[<>=!~\[; ]", str(req), 1)[0].strip()
+        module = {"beautifulsoup4": "bs4", "pyyaml": "yaml", "pillow": "PIL"}.get(name.lower(), name.replace("-", "_"))
+        if module and importlib.util.find_spec(module) is None:
+            missing.append(name)
+    if missing:
+        raise RuntimeError("missing libraries: " + ", ".join(missing) + " (GlassGram cannot install pip packages)")
+
+
+def _load(rec):
+    try:
+        _check_requirements(rec.meta)
+        spec = importlib.util.spec_from_file_location("glassplugin_" + rec.id.replace("-", "_"), rec.path)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        cls = None
+        for value in list(vars(module).values()):
+            if isinstance(value, type) and issubclass(value, BasePlugin) and value is not BasePlugin \
+                    and getattr(value, "__module__", None) == spec.name:
+                cls = value
+        if cls is None:
+            for value in list(vars(module).values()):
+                if isinstance(value, type) and issubclass(value, BasePlugin) and value is not BasePlugin:
+                    cls = value
+        if cls is None:
+            raise RuntimeError("no BasePlugin subclass found")
+        instance = cls()
+        instance._glass_bind(rec.id, os.path.join(_settings_dir, rec.id + ".json"))
+        rec.module = module
+        rec.instance = instance
+        rec.error = None
+        instance.on_plugin_load()
+        try:
+            instance.on_app_event(base_plugin.AppEvent.START)
+        except Exception:
+            pass
+        _log("loaded " + rec.id)
+    except Exception:
+        rec.error = traceback.format_exc(limit=4)
+        _err("failed to load %s: %s" % (rec.id, rec.error))
+        if rec.instance is not None:
+            try:
+                rec.instance._glass_cleanup()
+            except Exception:
+                pass
+        rec.instance = None
+    rebuild_hooks()
+
+
+def _unload(rec):
+    inst = rec.instance
+    if inst is None:
+        return
+    try:
+        inst.on_plugin_unload()
+    except Exception:
+        _err(traceback.format_exc())
+    try:
+        inst._glass_cleanup()
+    except Exception:
+        pass
+    rec.instance = None
+    rec.module = None
+    rebuild_hooks()
+
+
+def _loaded():
+    return [r.instance for r in _plugins.values() if r.instance is not None]
+
+
+def rebuild_hooks():
+    if _engine is None:
+        return
+    _engine.clearHooks()
+    send_hooks = 0
+    for inst in _loaded():
+        for name, (substring, _priority) in getattr(inst, "_hooks", {}).items():
+            for kind in (KIND_REQUEST, KIND_UPDATE, KIND_UPDATES):
+                _engine.registerHook(kind, name, substring)
+        if getattr(inst, "_send_hook", None) is not None:
+            send_hooks += 1
+    _engine.setSendMessageHookCount(send_hooks)
+
+
+# --- management (UI) ---
+
+def list_plugins():
+    with _lock:
+        _scan()
+        result = []
+        for rec in sorted(_plugins.values(), key=lambda r: str(r.meta.get("name", r.id)).lower()):
+            m = rec.meta
+            result.append({
+                "id": rec.id,
+                "name": str(m.get("name", rec.id)),
+                "description": str(m.get("description", "")),
+                "author": str(m.get("author", "")),
+                "version": str(m.get("version", "1.0")),
+                "icon": str(m.get("icon", "")),
+                "enabled": bool(_state.get(rec.id, True)),
+                "has_settings": rec.instance is not None and type(rec.instance).create_settings is not BasePlugin.create_settings,
+                "error": rec.error,
+            })
+        return json.dumps(result)
+
+
+def set_enabled(plugin_id, enabled):
+    with _lock:
+        rec = _plugins.get(plugin_id)
+        if rec is None:
+            return
+        _state[plugin_id] = bool(enabled)
+        _save_state()
+        if enabled:
+            if rec.instance is None:
+                rec.error = None
+                _load(rec)
+        else:
+            _unload(rec)
+
+
+def install(path):
+    meta = read_metadata(path)
+    plugin_id = meta.get("id")
+    if not isinstance(plugin_id, str) or not ID_RE.match(plugin_id):
+        raise ValueError("invalid or missing __id__")
+    if not meta.get("name"):
+        raise ValueError("missing __name__")
+    with _lock:
+        old = _plugins.get(plugin_id)
+        if old is not None:
+            _unload(old)
+            del _plugins[plugin_id]
+        target = os.path.join(_dir, plugin_id + ".py")
+        if os.path.abspath(path) != os.path.abspath(target):
+            shutil.copyfile(path, target)
+        rec = _Record(plugin_id, target, meta)
+        _plugins[plugin_id] = rec
+        _state[plugin_id] = True
+        _save_state()
+        _load(rec)
+    return plugin_id
+
+
+def delete(plugin_id):
+    with _lock:
+        rec = _plugins.pop(plugin_id, None)
+        if rec is None:
+            return
+        _unload(rec)
+        for p in (rec.path, os.path.join(_settings_dir, plugin_id + ".json")):
+            try:
+                os.remove(p)
+            except OSError:
+                pass
+        _state.pop(plugin_id, None)
+        _save_state()
+
+
+# --- settings screen ---
+
+def get_settings(plugin_id):
+    from ui import settings as S
+    rec = _plugins.get(plugin_id)
+    items = []
+    rec_items = []
+    if rec is not None and rec.instance is not None:
+        try:
+            created = rec.instance.create_settings() or []
+        except Exception:
+            created = [S.Text(text="create_settings() failed", subtext=traceback.format_exc(limit=2), red=True)]
+        inst = rec.instance
+        for it in created:
+            d = None
+            if isinstance(it, S.Header):
+                d = {"type": 0, "text": it.text}
+            elif isinstance(it, S.Switch):
+                d = {"type": 1, "key": it.key, "text": it.text, "subtext": it.subtext, "icon": it.icon,
+                     "checked": bool(inst.get_setting(it.key, it.default))}
+            elif isinstance(it, (S.Input, S.EditText)):
+                key = it.key
+                default = getattr(it, "default", "") or ""
+                d = {"type": 2, "key": key, "text": getattr(it, "text", None) or getattr(it, "hint", ""),
+                     "subtext": getattr(it, "subtext", None), "icon": getattr(it, "icon", None),
+                     "value": str(inst.get_setting(key, default) or "")}
+            elif isinstance(it, S.Selector):
+                d = {"type": 3, "key": it.key, "text": it.text, "icon": it.icon, "items": [str(x) for x in it.items],
+                     "selected": int(inst.get_setting(it.key, it.default) or 0)}
+            elif isinstance(it, S.Text):
+                d = {"type": 4, "text": it.text, "subtext": it.subtext, "icon": it.icon, "red": bool(it.red)}
+            elif isinstance(it, S.Divider):
+                d = {"type": 5, "text": it.text}
+            if d is not None:
+                items.append(d)
+                rec_items.append(it)
+        rec.settings_items = rec_items
+    return json.dumps(items)
+
+
+def setting_changed(plugin_id, index, value):
+    from ui import settings as S
+    rec = _plugins.get(plugin_id)
+    if rec is None or rec.instance is None or index >= len(rec.settings_items):
+        return
+    it = rec.settings_items[index]
+    try:
+        if isinstance(it, S.Switch):
+            value = bool(value)
+        elif isinstance(it, S.Selector):
+            value = int(value)
+        else:
+            value = "" if value is None else str(value)
+        rec.instance.set_setting(it.key, value)
+        if getattr(it, "on_change", None):
+            it.on_change(value)
+    except Exception:
+        _err(traceback.format_exc())
+
+
+def setting_clicked(plugin_id, index):
+    rec = _plugins.get(plugin_id)
+    if rec is None or rec.instance is None or index >= len(rec.settings_items):
+        return
+    it = rec.settings_items[index]
+    try:
+        if getattr(it, "on_click", None):
+            it.on_click(None)
+    except Exception:
+        _err(traceback.format_exc())
+
+
+# --- hook dispatch ---
+
+def _hooked(name):
+    result = []
+    for inst in _loaded():
+        hooks = getattr(inst, "_hooks", {})
+        for hook_name, (substring, priority) in hooks.items():
+            if hook_name == name or (substring and hook_name in name):
+                result.append((priority, inst))
+                break
+    result.sort(key=lambda x: -x[0])
+    return [inst for _p, inst in result]
+
+
+def _call(inst, method, *args):
+    try:
+        res = getattr(inst, method)(*args)
+        return res if isinstance(res, HookResult) else HookResult()
+    except Exception:
+        inst._report(method, traceback.format_exc())
+        return HookResult()
+
+
+def pre_request(name, account, request):
+    for inst in _hooked(name):
+        res = _call(inst, "pre_request_hook", name, account, request)
+        if res.strategy == HookStrategy.CANCEL:
+            return jarray(jclass("java.lang.Object"))([True, None])
+        if res.strategy in (HookStrategy.MODIFY, HookStrategy.MODIFY_FINAL) and res.request is not None:
+            request = res.request
+            if res.strategy == HookStrategy.MODIFY_FINAL:
+                break
+    return jarray(jclass("java.lang.Object"))([False, request])
+
+
+def post_request(name, account, response, error):
+    for inst in _hooked(name):
+        res = _call(inst, "post_request_hook", name, account, response, error)
+        if res.strategy == HookStrategy.CANCEL:
+            response, error = None, None
+            break
+        if res.strategy in (HookStrategy.MODIFY, HookStrategy.MODIFY_FINAL):
+            if res.response is not None:
+                response = res.response
+            if res.strategy == HookStrategy.MODIFY_FINAL:
+                break
+    return jarray(jclass("java.lang.Object"))([response, error])
+
+
+def send_message(account, params):
+    hooked = [(inst._send_hook, inst) for inst in _loaded() if getattr(inst, "_send_hook", None) is not None]
+    hooked.sort(key=lambda x: -x[0])
+    for _p, inst in hooked:
+        res = _call(inst, "on_send_message_hook", account, params)
+        if res.strategy == HookStrategy.CANCEL:
+            return True
+        if res.strategy == HookStrategy.MODIFY_FINAL:
+            break
+    return False
+
+
+def on_update(name, account, update):
+    for inst in _hooked(name):
+        res = _call(inst, "on_update_hook", name, account, update)
+        if res.strategy == HookStrategy.CANCEL:
+            return True
+        if res.strategy == HookStrategy.MODIFY_FINAL:
+            break
+    return False
+
+
+def on_updates(name, account, updates):
+    for inst in _hooked(name):
+        res = _call(inst, "on_updates_hook", name, account, updates)
+        if res.strategy in (HookStrategy.CANCEL, HookStrategy.MODIFY_FINAL):
+            break
