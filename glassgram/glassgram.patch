diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/GlassConfig.java b/TMessagesProj/src/main/java/org/telegram/messenger/GlassConfig.java
new file mode 100644
index 0000000..65d5bbf
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/GlassConfig.java
@@ -0,0 +1,131 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/**
+ * GlassGram mod settings. Stored in the "glassgram" shared preferences.
+ */
+public final class GlassConfig {
+
+    private GlassConfig() {
+    }
+
+    public static final int AVATAR_CIRCLE = 0;
+    public static final int AVATAR_SQUIRCLE = 1;
+    public static final int AVATAR_SQUARE = 2;
+
+    /** Corner radius of an avatar, as a fraction of the circle radius it replaces. */
+    private static final float[] AVATAR_CORNERS = {1f, 0.32f, 0.12f};
+
+    /** Liquid glass and blurred panels are switched on once, on the first launch of GlassGram. */
+    public static final boolean FORCE_GLASS_ON_FIRST_LAUNCH = true;
+
+    private static volatile boolean loaded;
+    private static int avatarShape = AVATAR_SQUIRCLE;
+    private static boolean saveDeleted = true;
+    private static boolean markDeleted = true;
+    private static boolean pluginsEnabled = true;
+    private static int stylePreset = 0;
+
+    public static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("glassgram", Context.MODE_PRIVATE);
+    }
+
+    private static void load() {
+        if (loaded) {
+            return;
+        }
+        synchronized (GlassConfig.class) {
+            if (loaded || ApplicationLoader.applicationContext == null) {
+                return;
+            }
+            final SharedPreferences p = prefs();
+            avatarShape = p.getInt("avatarShape", AVATAR_SQUIRCLE);
+            saveDeleted = p.getBoolean("saveDeleted", true);
+            markDeleted = p.getBoolean("markDeleted", true);
+            pluginsEnabled = p.getBoolean("pluginsEnabled", true);
+            stylePreset = p.getInt("stylePreset", 0);
+            loaded = true;
+        }
+    }
+
+    // --- avatars ---
+
+    public static int getAvatarShape() {
+        load();
+        return avatarShape;
+    }
+
+    public static void setAvatarShape(int shape) {
+        load();
+        avatarShape = Math.max(AVATAR_CIRCLE, Math.min(AVATAR_SQUARE, shape));
+        prefs().edit().putInt("avatarShape", avatarShape).apply();
+    }
+
+    public static boolean squareAvatars() {
+        return getAvatarShape() != AVATAR_CIRCLE;
+    }
+
+    public static float avatarCorner() {
+        return AVATAR_CORNERS[getAvatarShape()];
+    }
+
+    public static int avatarRadius(int circleRadius) {
+        return squareAvatars() ? Math.round(circleRadius * avatarCorner()) : circleRadius;
+    }
+
+    public static float avatarRadius(float circleRadius) {
+        return squareAvatars() ? circleRadius * avatarCorner() : circleRadius;
+    }
+
+    // --- deleted messages ---
+
+    public static boolean saveDeletedMessages() {
+        load();
+        return saveDeleted;
+    }
+
+    public static void setSaveDeletedMessages(boolean value) {
+        load();
+        saveDeleted = value;
+        prefs().edit().putBoolean("saveDeleted", value).apply();
+    }
+
+    public static boolean markDeletedMessages() {
+        load();
+        return markDeleted;
+    }
+
+    public static void setMarkDeletedMessages(boolean value) {
+        load();
+        markDeleted = value;
+        prefs().edit().putBoolean("markDeleted", value).apply();
+    }
+
+    // --- plugins ---
+
+    public static boolean pluginsEnabled() {
+        load();
+        return pluginsEnabled;
+    }
+
+    public static void setPluginsEnabled(boolean value) {
+        load();
+        pluginsEnabled = value;
+        prefs().edit().putBoolean("pluginsEnabled", value).apply();
+    }
+
+    // --- style ---
+
+    public static int getStylePreset() {
+        load();
+        return stylePreset;
+    }
+
+    public static void setStylePreset(int value) {
+        load();
+        stylePreset = value;
+        prefs().edit().putInt("stylePreset", value).apply();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/GlassDeletedStore.java b/TMessagesProj/src/main/java/org/telegram/messenger/GlassDeletedStore.java
new file mode 100644
index 0000000..1e68ecc
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/GlassDeletedStore.java
@@ -0,0 +1,98 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Map;
+
+/**
+ * GlassGram: remembers which messages were deleted on the server while "save deleted messages" is on.
+ * The messages themselves stay in the local database (their deletion is skipped in MessagesController),
+ * this store only keeps the ids so the chat can mark them as deleted.
+ *
+ * Keys: account + channel id (0 for private chats and basic groups, whose ids are per account) + message id.
+ */
+public final class GlassDeletedStore {
+
+    private GlassDeletedStore() {
+    }
+
+    private static final HashSet<String> deleted = new HashSet<>();
+    private static volatile boolean loaded;
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("glassgram_deleted", Context.MODE_PRIVATE);
+    }
+
+    private static String key(int account, long channelId, int messageId) {
+        return account + "_" + channelId + "_" + messageId;
+    }
+
+    private static void load() {
+        if (loaded) {
+            return;
+        }
+        synchronized (deleted) {
+            if (loaded) {
+                return;
+            }
+            for (Map.Entry<String, ?> e : prefs().getAll().entrySet()) {
+                deleted.add(e.getKey());
+            }
+            loaded = true;
+        }
+    }
+
+    /**
+     * Records server-side deletions. dialogId is 0 for TL_updateDeleteMessages, -channelId for channels.
+     */
+    public static void markDeleted(int account, long dialogId, ArrayList<Integer> messageIds) {
+        if (messageIds == null || messageIds.isEmpty()) {
+            return;
+        }
+        load();
+        final long channelId = dialogId < 0 ? -dialogId : 0;
+        final SharedPreferences.Editor editor = prefs().edit();
+        synchronized (deleted) {
+            for (int i = 0; i < messageIds.size(); i++) {
+                final String k = key(account, channelId, messageIds.get(i));
+                if (deleted.add(k)) {
+                    editor.putBoolean(k, true);
+                }
+            }
+        }
+        editor.apply();
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.glassMessagesMarkedDeleted, dialogId, messageIds));
+    }
+
+    public static boolean isDeleted(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null || messageObject.getId() <= 0) {
+            return false;
+        }
+        load();
+        final TLRPC.Peer peer = messageObject.messageOwner.peer_id;
+        final long channelId = peer != null ? peer.channel_id : 0;
+        synchronized (deleted) {
+            return deleted.contains(key(messageObject.currentAccount, channelId, messageObject.getId()));
+        }
+    }
+
+    public static int count() {
+        load();
+        synchronized (deleted) {
+            return deleted.size();
+        }
+    }
+
+    public static void clear() {
+        load();
+        synchronized (deleted) {
+            deleted.clear();
+        }
+        prefs().edit().clear().apply();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/GlassPlugins.java b/TMessagesProj/src/main/java/org/telegram/messenger/GlassPlugins.java
new file mode 100644
index 0000000..6c9eec8
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/GlassPlugins.java
@@ -0,0 +1,185 @@
+package org.telegram.messenger;
+
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.File;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * GlassGram plugin bridge. The plugin engine (embedded Python, exteraGram-compatible API) lives in the app
+ * module and registers itself here; Telegram code calls the static hook methods, which cost a volatile read
+ * when no plugin uses the hook.
+ */
+public final class GlassPlugins {
+
+    private GlassPlugins() {
+    }
+
+    public static class PluginInfo {
+        public String id;
+        public String name;
+        public String description;
+        public String author;
+        public String version;
+        public String icon;
+        public boolean enabled;
+        public boolean hasSettings;
+        public String error;
+    }
+
+    /** One row of a plugin settings screen (built from the plugin's create_settings()). */
+    public static class SettingItem {
+        public static final int HEADER = 0, SWITCH = 1, INPUT = 2, SELECTOR = 3, TEXT = 4, DIVIDER = 5;
+        public int type;
+        public String key;
+        public String text;
+        public String subtext;
+        public String icon;
+        public boolean checked;
+        public String value;
+        public String[] items;
+        public int selected;
+        public boolean red;
+        /** Index of the item inside the plugin's settings list, used to call back its on_click / on_change. */
+        public int index;
+    }
+
+    public interface Engine {
+        void start();
+        List<PluginInfo> list();
+        void setEnabled(String id, boolean enabled);
+        /** Installs (or updates) a plugin file and returns its id. */
+        String install(File file) throws Exception;
+        void delete(String id);
+        List<SettingItem> getSettings(String id);
+        void onSettingChanged(String id, int index, Object value);
+        void onSettingClicked(String id, int index);
+
+        TLObject preRequest(int account, TLObject request);
+        Object[] postRequest(int account, TLObject request, TLObject response, TLRPC.TL_error error);
+        boolean onSendMessage(int account, SendMessagesHelper.SendMessageParams params);
+        boolean onUpdate(int account, TLRPC.Update update);
+        void onUpdates(int account, TLRPC.Updates updates);
+    }
+
+    private static volatile Engine engine;
+
+    /** Set by the engine when a loaded plugin registers hooks of the kind. */
+    public static volatile boolean requestHooks;
+    public static volatile boolean sendMessageHooks;
+    public static volatile boolean updateHooks;
+
+    public static void setEngine(Engine value) {
+        engine = value;
+    }
+
+    public static Engine getEngine() {
+        return engine;
+    }
+
+    public static boolean isAvailable() {
+        return engine != null;
+    }
+
+    public static void start() {
+        final Engine e = engine;
+        if (e != null && GlassConfig.pluginsEnabled()) {
+            Utilities.globalQueue.postRunnable(() -> {
+                try {
+                    e.start();
+                } catch (Throwable t) {
+                    FileLog.e(t);
+                }
+            });
+        }
+    }
+
+    public static List<PluginInfo> list() {
+        final Engine e = engine;
+        if (e == null) {
+            return Collections.emptyList();
+        }
+        try {
+            return e.list();
+        } catch (Throwable t) {
+            FileLog.e(t);
+            return Collections.emptyList();
+        }
+    }
+
+    public static boolean isPluginFile(String name) {
+        return name != null && name.toLowerCase().endsWith(".plugin");
+    }
+
+    // --- hooks, called from Telegram code ---
+
+    /** @return the request to send, or null to cancel it. */
+    public static TLObject preRequest(int account, TLObject request) {
+        final Engine e = engine;
+        if (!requestHooks || e == null || request == null) {
+            return request;
+        }
+        try {
+            return e.preRequest(account, request);
+        } catch (Throwable t) {
+            FileLog.e(t);
+            return request;
+        }
+    }
+
+    /** @return {response, error} after plugins had a look. */
+    public static Object[] postRequest(int account, TLObject request, TLObject response, TLRPC.TL_error error) {
+        final Engine e = engine;
+        if (!requestHooks || e == null) {
