+"""GlassGram plugin API: Android helpers (exteraGram android_utils)."""
+
+from java import dynamic_proxy, jclass
+
+_AndroidUtilities = jclass("org.telegram.messenger.AndroidUtilities")
+_Log = jclass("android.util.Log")
+_Runnable = jclass("java.lang.Runnable")
+_View = jclass("android.view.View")
+
+
+class R(dynamic_proxy(_Runnable)):
+    """Wraps a Python callable into java.lang.Runnable."""
+
+    def __init__(self, fn):
+        super().__init__()
+        self.fn = fn
+
+    def run(self):
+        try:
+            self.fn()
+        except Exception:
+            import traceback
+            _Log.e("GlassPlugins", traceback.format_exc())
+
+
+class OnClickListener(dynamic_proxy(_View.OnClickListener)):
+    def __init__(self, fn):
+        super().__init__()
+        self.fn = fn
+
+    def onClick(self, view):
+        self.fn(view)
+
+
+class OnLongClickListener(dynamic_proxy(_View.OnLongClickListener)):
+    def __init__(self, fn):
+        super().__init__()
+        self.fn = fn
+
+    def onLongClick(self, view):
+        return bool(self.fn(view))
+
+
+def run_on_ui_thread(func, delay=0):
+    _AndroidUtilities.runOnUIThread(R(func), int(delay))
+
+
+def log(data):
+    text = data if isinstance(data, (str, int, float, bool)) or data is None else repr(data)
+    _Log.i("GlassPlugins", str(text))
+
+
+def copy_to_clipboard(text):
+    ok = _AndroidUtilities.addToClipboard(str(text))
+    try:
+        from ui.bulletin import BulletinHelper
+        BulletinHelper.show_copied_to_clipboard()
+    except Exception:
+        pass
+    return ok
diff --git a/TMessagesProj_App/src/main/python/base_plugin.py b/TMessagesProj_App/src/main/python/base_plugin.py
new file mode 100644
index 0000000..e3fd60d
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/base_plugin.py
@@ -0,0 +1,450 @@
+"""GlassGram plugin API: BasePlugin and hook contracts, compatible with exteraGram plugins."""
+
+import json
+import os
+import traceback
+from dataclasses import dataclass
+from typing import Any, Callable, Dict, List, Optional
+
+from java import dynamic_proxy, jclass
+
+_Log = jclass("android.util.Log")
+
+
+class HookStrategy:
+    DEFAULT = "DEFAULT"
+    CANCEL = "CANCEL"
+    MODIFY = "MODIFY"
+    MODIFY_FINAL = "MODIFY_FINAL"
+
+
+class HookResult:
+    def __init__(self, strategy=HookStrategy.DEFAULT, request=None, response=None,
+                 update=None, updates=None, params=None, result=None):
+        self.strategy = strategy
+        self.request = request
+        self.response = response
+        self.update = update
+        self.updates = updates
+        self.params = params
+        self.result = result
+
+    def __repr__(self):
+        return "HookResult(%s)" % self.strategy
+
+
+class AppEvent:
+    START = "START"
+    STOP = "STOP"
+    PAUSE = "PAUSE"
+    RESUME = "RESUME"
+
+
+class MenuItemType:
+    MESSAGE_CONTEXT_MENU = "MESSAGE_CONTEXT_MENU"
+    DRAWER_MENU = "DRAWER_MENU"
+    MAIN_MENU = "MAIN_MENU"
+    CHAT_ACTION_MENU = "CHAT_ACTION_MENU"
+    PROFILE_ACTION_MENU = "PROFILE_ACTION_MENU"
+
+
+@dataclass
+class MenuItemData:
+    menu_type: str
+    text: str
+    on_click: Callable[[dict], None] = None
+    item_id: Optional[str] = None
+    icon: Optional[str] = None
+    subtext: Optional[str] = None
+    condition: Optional[str] = None
+    priority: int = 0
+
+
+# --- method hooks (Xposed style) ---
+
+class MethodHook:
+    """Override before_hooked_method / after_hooked_method. param: thisObject, args, method, getResult(), setResult()."""
+
+    def before_hooked_method(self, param):
+        pass
+
+    def after_hooked_method(self, param):
+        pass
+
+
+class MethodReplacement(MethodHook):
+    """Override replace_hooked_method; its return value replaces the method result."""
+
+    def replace_hooked_method(self, param):
+        return None
+
+
+class BaseHook(MethodHook):
+    def __init__(self, before=None, after=None, before_filters=None, after_filters=None):
+        self._before = before
+        self._after = after
+        self._before_filters = before_filters or []
+        self._after_filters = after_filters or []
+
+    def before_hooked_method(self, param):
+        if self._before is not None and _filters_pass(self._before_filters, param, False):
+            self._before(param)
+
+    def after_hooked_method(self, param):
+        if self._after is not None and _filters_pass(self._after_filters, param, True):
+            self._after(param)
+
+
+class _Filter:
+    def __init__(self, check, after_only=False):
+        self.check = check
+        self.after_only = after_only
+
+    def test(self, param, after):
+        if self.after_only and not after:
+            return True
+        try:
+            return bool(self.check(param))
+        except Exception:
+            return False
+
+
+def _arg(param, i):
+    args = param.args
+    return args[i] if args is not None and i < len(args) else None
+
+
+def _same(a, b):
+    try:
+        return a == b or (a is not None and hasattr(a, "equals") and a.equals(b))
+    except Exception:
+        return False
+
+
+class HookFilter:
+    RESULT_IS_NULL = _Filter(lambda p: p.getResult() is None, True)
+    RESULT_IS_TRUE = _Filter(lambda p: p.getResult() is True, True)
+    RESULT_IS_FALSE = _Filter(lambda p: p.getResult() is False, True)
+    RESULT_NOT_NULL = _Filter(lambda p: p.getResult() is not None, True)
+
+    @staticmethod
+    def ResultIsInstanceOf(clazz):
+        return _Filter(lambda p: p.getResult() is not None and clazz.isInstance(p.getResult()), True)
+
+    @staticmethod
+    def ResultEqual(v):
+        return _Filter(lambda p: _same(p.getResult(), v), True)
+
+    @staticmethod
+    def ResultNotEqual(v):
+        return _Filter(lambda p: not _same(p.getResult(), v), True)
+
+    @staticmethod
+    def ArgumentIsNull(i):
+        return _Filter(lambda p: _arg(p, i) is None)
+
+    @staticmethod
+    def ArgumentNotNull(i):
+        return _Filter(lambda p: _arg(p, i) is not None)
+
+    @staticmethod
+    def ArgumentIsFalse(i):
+        return _Filter(lambda p: _arg(p, i) is False)
+
+    @staticmethod
+    def ArgumentIsTrue(i):
+        return _Filter(lambda p: _arg(p, i) is True)
+
+    @staticmethod
+    def ArgumentIsInstanceOf(i, clazz):
+        return _Filter(lambda p: _arg(p, i) is not None and clazz.isInstance(_arg(p, i)))
+
+    @staticmethod
+    def ArgumentEqual(i, v):
+        return _Filter(lambda p: _same(_arg(p, i), v))
+
+    @staticmethod
+    def ArgumentNotEqual(i, v):
+        return _Filter(lambda p: not _same(_arg(p, i), v))
+
+    @staticmethod
+    def Condition(expression, object=None):
+        # MVEL expressions are not supported by GlassGram: the filter always passes
+        return _Filter(lambda p: True)
+
+    @staticmethod
+    def Or(*filters):
+        return _Filter(lambda p: any(f.check(p) for f in filters))
+
+
+def hook_filters(*filters):
+    def decorator(fn):
+        fn._glass_filters = list(filters)
+        return fn
+    return decorator
+
+
+def _filters_pass(filters, param, after):
+    for f in filters:
+        if isinstance(f, _Filter) and not f.test(param, after):
+            return False
+    return True
+
+
+_Bridge = None
+
+
+def _bridge():
+    global _Bridge
+    if _Bridge is None:
+        _Bridge = jclass("org.telegram.messenger.glass.GlassHookBridge")
+    return _Bridge
+
+
+def _make_callback(plugin, handler):
+    bridge = _bridge()
+
+    class _Callback(dynamic_proxy(bridge.Callback)):
+        def before(self, param):
+            try:
+                if isinstance(handler, MethodReplacement):
+                    param.setResult(handler.replace_hooked_method(param))
+                    return
+                fn = handler.before_hooked_method
+                if _filters_pass(getattr(fn, "_glass_filters", []), param, False):
+                    fn(param)
+            except Exception:
+                plugin._report("before_hooked_method", traceback.format_exc())
+
+        def after(self, param):
+            try:
+                if isinstance(handler, MethodReplacement):
+                    return
+                fn = handler.after_hooked_method
+                if _filters_pass(getattr(fn, "_glass_filters", []), param, True):
+                    fn(param)
+            except Exception:
+                plugin._report("after_hooked_method", traceback.format_exc())
+
+    return _Callback()
+
+
+class _Logger:
+    def __init__(self, tag):
+        self.tag = tag
+
+    def _fmt(self, msg, args):
+        try:
+            return str(msg) % args if args else str(msg)
+        except Exception:
+            return str(msg)
+
+    def verbose(self, msg, *args, exc_info=None):
+        _Log.v(self.tag, self._fmt(msg, args))
+
+    def debug(self, msg, *args, exc_info=None):
+        _Log.d(self.tag, self._fmt(msg, args))
+
+    def info(self, msg, *args, exc_info=None):
+        _Log.i(self.tag, self._fmt(msg, args))
+
+    def warning(self, msg, *args, exc_info=None):
+        _Log.w(self.tag, self._fmt(msg, args))
+
+    def error(self, msg, *args, exc_info=None):
+        text = self._fmt(msg, args)
+        if exc_info:
+            text += "\n" + traceback.format_exc()
+        _Log.e(self.tag, text)
+
+    def exception(self, msg, *args):
+        self.error(msg, *args, exc_info=True)
+
+    def dump(self, obj, label=None, depth=2, max_items=20):
+        _Log.d(self.tag, (label + ": " if label else "") + repr(obj))
+
+    def child(self, name):
+        return _Logger(self.tag + "." + name)
+
+    def timed(self, label):
+        import time
+        logger = self
+
+        class _Timer:
+            def __enter__(self):
+                self.t = time.monotonic()
+                return self
+
+            def __exit__(self, *a):
+                logger.debug("%s: %.1f ms", label, (time.monotonic() - self.t) * 1000)
+                return False
+
+        return _Timer()
+
+
+class BasePlugin:
+    """Base class of a plugin. One subclass per .plugin file; it is created without arguments."""
+
+    def __init__(self):
+        self.id = getattr(self, "id", None)
+        self._hooks = {}          # TL class name -> (match_substring, priority)
+        self._send_hook = None    # priority or None
+        self._method_hooks = []
+        self._menu_items = {}
+        self._settings = None
+        self._settings_path = None
+        self.logger = _Logger("plugin")
+
+    # internal: called by glass_engine
+    def _glass_bind(self, plugin_id, settings_path):
+        self.id = plugin_id
+        self._settings_path = settings_path
+        self.logger = _Logger("plugin." + plugin_id)
+        if not hasattr(self, "_hooks"):
+            BasePlugin.__init__(self)
+            self.id = plugin_id
+            self._settings_path = settings_path
+            self.logger = _Logger("plugin." + plugin_id)
+
+    def _glass_cleanup(self):
+        for unhook in list(self._method_hooks):
+            try:
+                _bridge().unhook(unhook)
+            except Exception:
+                pass
+        self._method_hooks = []
+        self._hooks = {}
+        self._send_hook = None
+        self._menu_items = {}
+
+    def _report(self, where, text):
+        _Log.e("plugin." + str(self.id), where + ": " + text)
+
+    # lifecycle
+    def on_plugin_load(self):
+        pass
+
+    def on_plugin_unload(self):
+        pass
+
+    def on_app_event(self, event_type):
+        pass
+
+    def create_settings(self) -> List[Any]:
+        return []
+
+    # logging
+    def log(self, message):
+        self.logger.info(str(message))
+
+    # settings
+    def _load_settings(self):
+        if self._settings is None:
+            self._settings = {}
+            try:
+                if self._settings_path and os.path.exists(self._settings_path):
+                    with open(self._settings_path, "r", encoding="utf-8") as f:
+                        self._settings = json.load(f)
+            except Exception:
+                self._settings = {}
+        return self._settings
+
+    def _save_settings(self):
+        if not self._settings_path:
+            return
+        try:
+            os.makedirs(os.path.dirname(self._settings_path), exist_ok=True)
+            with open(self._settings_path, "w", encoding="utf-8") as f:
+                json.dump(self._settings or {}, f)
+        except Exception:
+            self._report("save_settings", traceback.format_exc())
+
+    def get_setting(self, key, default=None):
+        return self._load_settings().get(key, default)
+
+    def set_setting(self, key, value, reload_settings=False):
+        self._load_settings()[key] = value
+        self._save_settings()
+
+    def export_settings(self) -> Dict[str, Any]:
+        return dict(self._load_settings())
+
+    def import_settings(self, settings, reload_settings=True):
+        self._load_settings().update(settings or {})
+        self._save_settings()
+
+    # event hooks
+    def add_hook(self, name, match_substring=False, priority=0):
+        self._hooks[name] = (bool(match_substring), priority)
+        _engine_changed()
+
+    def remove_hook(self, name):
+        self._hooks.pop(name, None)
+        _engine_changed()
+
+    def add_on_send_message_hook(self, priority=0):
+        self._send_hook = priority
+        _engine_changed()
+
+    def pre_request_hook(self, request_name, account, request):
+        return HookResult()
+
+    def post_request_hook(self, request_name, account, response, error):
+        return HookResult()
+
+    def on_update_hook(self, update_name, account, update):
+        return HookResult()
+
+    def on_updates_hook(self, container_name, account, updates):
+        return HookResult()
+
+    def on_send_message_hook(self, account, params):
+        return HookResult()
+
+    # method hooks
+    def hook_method(self, method, handler=None, priority=0, before=None, after=None,
+                    before_filters=None, after_filters=None):
+        if handler is None:
+            handler = BaseHook(before, after, before_filters, after_filters)
+        unhook = _bridge().hook(method, _make_callback(self, handler))
+        self._method_hooks.append(unhook)
+        return unhook
+
+    def hook_all_methods(self, clazz, name, handler, priority=0):
+        result = []
+        for m in clazz.getDeclaredMethods():
+            if m.getName() == name:
+                result.append(self.hook_method(m, handler, priority))
+        return result
+
+    def hook_all_constructors(self, clazz, handler, priority=0):
+        return [self.hook_method(c, handler, priority) for c in clazz.getDeclaredConstructors()]
+
+    def unhook_method(self, unhook):
+        try:
+            _bridge().unhook(unhook)
+        finally:
+            if unhook in self._method_hooks:
+                self._method_hooks.remove(unhook)
+
+    # menus (stored; GlassGram does not show plugin menu items yet)
+    def add_menu_item(self, item: MenuItemData):
+        item_id = item.item_id or ("%s_%d" % (self.id, len(self._menu_items)))
+        self._menu_items[item_id] = item
+        return item_id
+
+    def remove_menu_item(self, item_id):
+        self._menu_items.pop(item_id, None)
+
+    # SDK 1.4.5 style per-account client
+    def client(self, account):
+        import client_utils
+        return client_utils.get_client(account)
+
+
+def _engine_changed():
+    try:
+        import glass_engine
+        glass_engine.rebuild_hooks()
+    except Exception:
+        pass
diff --git a/TMessagesProj_App/src/main/python/client_utils.py b/TMessagesProj_App/src/main/python/client_utils.py
new file mode 100644
index 0000000..f5fd5e7
--- /dev/null
+++ b/TMessagesProj_App/src/main/python/client_utils.py
@@ -0,0 +1,235 @@
+"""GlassGram plugin API: Telegram client helpers (exteraGram client_utils)."""
+
+from java import dynamic_proxy, jclass
+
+from android_utils import R
+
+_Utilities = jclass("org.telegram.messenger.Utilities")
+_DispatchQueue = jclass("org.telegram.messenger.DispatchQueue")
+_UserConfig = jclass("org.telegram.messenger.UserConfig")
+_AccountInstance = jclass("org.telegram.messenger.AccountInstance")
+_ConnectionsManager = jclass("org.telegram.tgnet.ConnectionsManager")
+_RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")
+_SendMessagesHelper = jclass("org.telegram.messenger.SendMessagesHelper")
+_LaunchActivity = jclass("org.telegram.ui.LaunchActivity")
+_MediaController = jclass("org.telegram.messenger.MediaController")
+_ArrayList = jclass("java.util.ArrayList")
+
+STAGE_QUEUE = "stageQueue"
+GLOBAL_QUEUE = "globalQueue"
+CACHE_CLEAR_QUEUE = "cacheClearQueue"
+SEARCH_QUEUE = "searchQueue"
+PHONE_BOOK_QUEUE = "phoneBookQueue"
+THEME_QUEUE = "themeQueue"
+EXTERNAL_NETWORK_QUEUE = "externalNetworkQueue"
+PLUGINS_QUEUE = "pluginsQueue"
+
+_plugins_queue = None
+
+
+def get_queue_by_name(name):
+    global _plugins_queue
+    if name == PLUGINS_QUEUE:
+        if _plugins_queue is None:
+            _plugins_queue = _DispatchQueue("pluginsQueue")
+        return _plugins_queue
+    return getattr(_Utilities, name)
+
+
+def run_on_queue(fn, queue=PLUGINS_QUEUE, delay_ms=0, queue_name=None):
+    q = get_queue_by_name(queue_name or queue)
+    q.postRunnable(R(fn), int(delay_ms))
+
+
+def get_selected_account():
+    return _UserConfig.selectedAccount
+
+
+def _acc(account):
+    return get_selected_account() if account is None else int(account)
+
+
+def get_account_instance(account=None):
+    return _AccountInstance.getInstance(_acc(account))
+
+
+def get_messages_controller(account=None):
+    return get_account_instance(account).getMessagesController()
+
+
+def get_contacts_controller(account=None):
+    return get_account_instance(account).getContactsController()
+
+
+def get_media_data_controller(account=None):
+    return get_account_instance(account).getMediaDataController()
+
+
+def get_connections_manager(account=None):
+    return get_account_instance(account).getConnectionsManager()
+
+
+def get_location_controller(account=None):
+    return get_account_instance(account).getLocationController()
+
+
+def get_notifications_controller(account=None):
+    return get_account_instance(account).getNotificationsController()
+
+
+def get_messages_storage(account=None):
+    return get_account_instance(account).getMessagesStorage()
+
+
+def get_send_messages_helper(account=None):
+    return get_account_instance(account).getSendMessagesHelper()
+
+
+def get_file_loader(account=None):
+    return get_account_instance(account).getFileLoader()
+
+
+def get_secret_chat_helper(account=None):
+    return get_account_instance(account).getSecretChatHelper()
+
+
+def get_download_controller(account=None):
+    return get_account_instance(account).getDownloadController()
+
+
+def get_notifications_settings(account=None):
+    return get_account_instance(account).getNotificationsSettings()
+
+
+def get_notification_center(account=None):
+    return get_account_instance(account).getNotificationCenter()
+
+
+def get_user_config(account=None):
+    return get_account_instance(account).getUserConfig()
+
+
+def get_media_controller():
+    return _MediaController.getInstance()
+
+
+def get_last_fragment():
+    return _LaunchActivity.getLastFragment()
+
+
+class RequestCallback(dynamic_proxy(_RequestDelegate)):
+    def __init__(self, fn):
+        super().__init__()
+        self.fn = fn
+
+    def run(self, response, error):
+        try:
+            self.fn(response, error)
+        except Exception:
+            import traceback
+            jclass("android.util.Log").e("GlassPlugins", traceback.format_exc())
+
+
+def send_request(tlobject, callback=None, account=None):
+    delegate = callback if isinstance(callback, RequestCallback) else RequestCallback(callback or (lambda r, e: None))
+    return get_connections_manager(account).sendRequest(tlobject, delegate)
+
+
+def _entities_list(entities):
+    if entities is None:
+        return None
+    if hasattr(entities, "size"):
+        return entities
+    lst = _ArrayList()
+    for e in entities:
+        lst.add(e.to_tlrpc_object() if hasattr(e, "to_tlrpc_object") else e)
+    return lst
+
+
+def _apply_parse_mode(text, parse_mode, entities):
+    if not parse_mode or text is None:
+        return text, entities
+    from extera_utils.text_formatting import parse_text
+    parsed = parse_text(text, parse_mode)
+    return parsed["message"], parsed["entities"]
+
+
+def send_message(params, parse_mode=None, account=None):
+    peer = int(params["peer"])
+    text = params.get("message")
+    entities = params.get("entities")
+    text, entities = _apply_parse_mode(text, parse_mode, entities)
+    p = _SendMessagesHelper.SendMessageParams.of(text, peer)
+    if params.get("replyToMsg") is not None:
+        p.replyToMsg = params["replyToMsg"]
+    if params.get("replyToTopMsg") is not None:
+        p.replyToTopMsg = params["replyToTopMsg"]
+    if entities is not None:
+        p.entities = _entities_list(entities)
+    if params.get("replyMarkup") is not None:
+        p.replyMarkup = params["replyMarkup"]
+    if "notify" in params:
+        p.notify = bool(params["notify"])
+    if params.get("scheduleDate"):
+        p.scheduleDate = int(params["scheduleDate"])
+    if params.get("caption") is not None:
+        p.caption = params["caption"]
+    get_send_messages_helper(account).sendMessage(p)
+    return p
+
+
+def send_text(peer_id, text, replyToMsg=None, parse_mode=None, account=None):
+    return send_message({"peer": peer_id, "message": text, "replyToMsg": replyToMsg}, parse_mode, account)
+
+
+def send_document(peer, path, caption=None, account=None, replyToMsg=None):
+    _SendMessagesHelper.prepareSendingDocument(get_account_instance(account), path, path, None, caption, None,
+                                               int(peer), replyToMsg, replyToMsg, None, None, None, True, 0, None, None, False)
+
+
+def send_photo(peer, path, caption=None, high_quality=False, account=None, replyToMsg=None):
+    _SendMessagesHelper.prepareSendingPhoto(get_account_instance(account), path, None, int(peer), replyToMsg, replyToMsg,
+                                            None, caption, None, None, None, 0, None, True, 0, 0, None)
+
+
+def send_video(peer, path, caption=None, account=None):
+    send_document(peer, path, caption, account)
+
+
+def send_audio(peer, path, caption=None, account=None):
+    send_document(peer, path, caption, account)
+
+
+def edit_message(message_obj, text=None, file_path=None, with_spoiler=False, parse_mode=None, account=None):
+    entities = None
+    text, entities = _apply_parse_mode(text, parse_mode, entities)
+    get_send_messages_helper(account).editMessage(message_obj, text, False, None, _entities_list(entities), 0, 0)
+
+
+class _Client:
+    def __init__(self, account):
+        self.account = int(account)
+
+    def __getattr__(self, name):
+        fn = globals().get(name)
+        if not callable(fn):
+            raise AttributeError(name)
+
+        def bound(*args, **kwargs):
+            kwargs.setdefault("account", self.account)
+            return fn(*args, **kwargs)
+
+        return bound
+
+
+def get_client(account=None):
+    return _Client(_acc(account))
+
+
+def get_hook_account():
+    return get_selected_account()
+
+
+class NotificationCenterDelegate(dynamic_proxy(jclass("org.telegram.messenger.NotificationCenter").NotificationCenterDelegate)):
+    def didReceivedNotification(self, id, account, args):
+        pass
