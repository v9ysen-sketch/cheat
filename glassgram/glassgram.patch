+++ b/TMessagesProj/src/main/java/org/telegram/ui/GlassSettingsActivity.java
@@ -0,0 +1,222 @@
+package org.telegram.ui;
+
+import static org.telegram.messenger.LocaleController.getString;
+
+import android.content.Context;
+import android.content.Intent;
+import android.view.View;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.GlassConfig;
+import org.telegram.messenger.GlassDeletedStore;
+import org.telegram.messenger.LiteMode;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SharedConfig;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.utils.glass.GlassEngine;
+
+import java.util.ArrayList;
+
+/**
+ * GlassGram mod settings: liquid glass, styles, avatars, deleted messages, plugins.
+ */
+public class GlassSettingsActivity extends UniversalFragment {
+
+    private static final int ID_LIQUID_GLASS = 1;
+    private static final int ID_BLUR = 2;
+    private static final int ID_STYLE_BASE = 100;
+    private static final int ID_AVATAR_BASE = 200;
+    private static final int ID_SAVE_DELETED = 3;
+    private static final int ID_MARK_DELETED = 4;
+    private static final int ID_CLEAR_DELETED = 5;
+    private static final int ID_PLUGINS = 6;
+    private static final int ID_RESTART = 7;
+
+    /** Style presets: accents of the "Dark Blue" theme (see Theme.java, GlassGram accents). */
+    public static final int[] STYLE_ACCENT_IDS = {0, 50, 51, 52, 53, 54, 55};
+    private static final int[] STYLE_NAMES = {
+        R.string.GlassStyleNavy, R.string.GlassStyleIce, R.string.GlassStyleViolet, R.string.GlassStyleEmerald,
+        R.string.GlassStyleSunset, R.string.GlassStyleGold, R.string.GlassStyleAmoled
+    };
+    private static final int[] AVATAR_NAMES = {R.string.GlassAvatarCircle, R.string.GlassAvatarSquircle, R.string.GlassAvatarSquare};
+    private static final int[] BUBBLE_RADII = {4, 8, 12, 17};
+
+    private boolean needRestart;
+
+    @Override
+    protected CharSequence getTitle() {
+        return getString(R.string.GlassSettings);
+    }
+
+    @Override
+    protected boolean useSimpleActionBar() {
+        return true;
+    }
+
+    @Override
+    public View createView(Context context) {
+        fragmentView = super.createView(context);
+        listView.setSections();
+        listView.setSectionsDrawBackground(true);
+        return fragmentView;
+    }
+
+    @Override
+    protected RecyclerListView getListViewForSimpleGlass() {
+        return listView;
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asHeader(getString(R.string.GlassSectionGlass)));
+        items.add(UItem.asCheck(ID_LIQUID_GLASS, getString(R.string.GlassLiquidGlass)).setChecked(LiteMode.isEnabledSetting(LiteMode.FLAG_LIQUID_GLASS)));
+        items.add(UItem.asCheck(ID_BLUR, getString(R.string.GlassBlur)).setChecked(LiteMode.isEnabledSetting(LiteMode.FLAG_CHAT_BLUR)));
+        items.add(UItem.asShadow(getString(R.string.GlassLiquidGlassInfo)));
+
+        items.add(UItem.asHeader(getString(R.string.GlassSectionStyle)));
+        final int preset = currentStyleIndex();
+        for (int i = 0; i < STYLE_ACCENT_IDS.length; i++) {
+            items.add(UItem.asRadio(ID_STYLE_BASE + i, getString(STYLE_NAMES[i])).setChecked(i == preset));
+        }
+        items.add(UItem.asShadow(getString(R.string.GlassStyleInfo)));
+
+        items.add(UItem.asHeader(getString(R.string.GlassSectionAvatars)));
+        final int shape = GlassConfig.getAvatarShape();
+        for (int i = 0; i < AVATAR_NAMES.length; i++) {
+            items.add(UItem.asRadio(ID_AVATAR_BASE + i, getString(AVATAR_NAMES[i])).setChecked(i == shape));
+        }
+        items.add(UItem.asShadow(null));
+
+        items.add(UItem.asHeader(getString(R.string.GlassSectionBubbles)));
+        final String[] radii = new String[BUBBLE_RADII.length];
+        int chosen = 0;
+        for (int i = 0; i < BUBBLE_RADII.length; i++) {
+            radii[i] = String.valueOf(BUBBLE_RADII[i]);
+            if (Math.abs(BUBBLE_RADII[i] - SharedConfig.bubbleRadius) < Math.abs(BUBBLE_RADII[chosen] - SharedConfig.bubbleRadius)) {
+                chosen = i;
+            }
+        }
+        items.add(UItem.asSlideView(radii, chosen, this::setBubbleRadius));
+        items.add(UItem.asShadow(getString(R.string.GlassBubblesInfo)));
+
+        items.add(UItem.asHeader(getString(R.string.GlassSectionMessages)));
+        items.add(UItem.asCheck(ID_SAVE_DELETED, getString(R.string.GlassSaveDeleted)).setChecked(GlassConfig.saveDeletedMessages()));
+        items.add(UItem.asCheck(ID_MARK_DELETED, getString(R.string.GlassMarkDeleted)).setChecked(GlassConfig.markDeletedMessages()).setEnabled(GlassConfig.saveDeletedMessages()));
+        final int count = GlassDeletedStore.count();
+        if (count > 0) {
+            items.add(UItem.asButton(ID_CLEAR_DELETED, R.drawable.msg_delete, getString(R.string.GlassClearDeleted), String.valueOf(count)).red());
+        }
+        items.add(UItem.asShadow(getString(R.string.GlassSaveDeletedInfo)));
+
+        items.add(UItem.asHeader(getString(R.string.GlassSectionPlugins)));
+        items.add(UItem.asButton(ID_PLUGINS, R.drawable.msg_bots, getString(R.string.GlassPlugins)));
+        items.add(UItem.asShadow(getString(R.string.GlassPluginsInfo)));
+
+        if (needRestart) {
+            items.add(UItem.asButton(ID_RESTART, R.drawable.msg_retry, getString(R.string.GlassRestart)).accent());
+            items.add(UItem.asShadow(null));
+        }
+    }
+
+    private int currentStyleIndex() {
+        final Theme.ThemeInfo current = Theme.getActiveTheme();
+        if (current != null && "Dark Blue".equals(current.getKey())) {
+            for (int i = 0; i < STYLE_ACCENT_IDS.length; i++) {
+                if (STYLE_ACCENT_IDS[i] == current.currentAccentId) {
+                    return i;
+                }
+            }
+            return -1;
+        }
+        return -1;
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        final int id = item.id;
+        if (id == ID_LIQUID_GLASS || id == ID_BLUR) {
+            final int flag = id == ID_LIQUID_GLASS ? LiteMode.FLAG_LIQUID_GLASS : LiteMode.FLAG_CHAT_BLUR;
+            LiteMode.toggleFlag(flag, !LiteMode.isEnabledSetting(flag));
+            GlassEngine.getCurrentGlassSettings();
+            needRestart = true;
+        } else if (id >= ID_STYLE_BASE && id < ID_STYLE_BASE + STYLE_ACCENT_IDS.length) {
+            applyStyle(id - ID_STYLE_BASE, view);
+        } else if (id >= ID_AVATAR_BASE && id < ID_AVATAR_BASE + AVATAR_NAMES.length) {
+            GlassConfig.setAvatarShape(id - ID_AVATAR_BASE);
+            needRestart = true;
+        } else if (id == ID_SAVE_DELETED) {
+            GlassConfig.setSaveDeletedMessages(!GlassConfig.saveDeletedMessages());
+        } else if (id == ID_MARK_DELETED) {
+            if (!GlassConfig.saveDeletedMessages()) {
+                return;
+            }
+            GlassConfig.setMarkDeletedMessages(!GlassConfig.markDeletedMessages());
+        } else if (id == ID_CLEAR_DELETED) {
+            new AlertDialog.Builder(getContext(), getResourceProvider())
+                .setTitle(getString(R.string.GlassClearDeleted))
+                .setMessage(getString(R.string.GlassClearDeletedInfo))
+                .setPositiveButton(getString(R.string.OK), (d, w) -> {
+                    GlassDeletedStore.clear();
+                    listView.adapter.update(true);
+                })
+                .setNegativeButton(getString(R.string.Cancel), null)
+                .makeRed(AlertDialog.BUTTON_POSITIVE)
+                .show();
+            return;
+        } else if (id == ID_PLUGINS) {
+            presentFragment(new GlassPluginsActivity());
+            return;
+        } else if (id == ID_RESTART) {
+            restartApp();
+            return;
+        }
+        listView.adapter.update(true);
+    }
+
+    private void applyStyle(int index, View from) {
+        final Theme.ThemeInfo theme = Theme.getTheme("Dark Blue");
+        if (theme == null) {
+            return;
+        }
+        final int accentId = STYLE_ACCENT_IDS[index];
+        GlassConfig.setStylePreset(index);
+        theme.setCurrentAccentId(accentId);
+        Theme.saveThemeAccents(theme, true, false, true, false);
+        Theme.switchThemeWithReveal(theme, false, accentId, from);
+    }
+
+    private void setBubbleRadius(int index) {
+        final int radius = BUBBLE_RADII[Math.max(0, Math.min(BUBBLE_RADII.length - 1, index))];
+        if (radius == SharedConfig.bubbleRadius) {
+            return;
+        }
+        SharedConfig.bubbleRadius = radius;
+        MessagesController.getGlobalMainSettings().edit().putInt("bubbleRadius", radius).apply();
+        Theme.reloadAllResources(getContext());
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, getString(R.string.GlassBubblesApplied)).show();
+    }
+
+    public static void restartApp() {
+        final Context context = ApplicationLoader.applicationContext;
+        final Intent intent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName());
+        if (intent == null) {
+            return;
+        }
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+        context.startActivity(intent);
+        AndroidUtilities.runOnUIThread(() -> Runtime.getRuntime().exit(0), 300);
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
