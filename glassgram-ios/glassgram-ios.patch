+                    let rawStorySubscriptions = GlassGramSettings.hideStories ? EngineStorySubscriptions(accountItem: nil, items: [], hasMoreToken: nil) : rawStorySubscriptions
                     
                     self.rawStorySubscriptions = rawStorySubscriptions
                     var items: [EngineStorySubscriptions.Item] = []
