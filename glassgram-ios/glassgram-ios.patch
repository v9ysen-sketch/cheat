+        GlassGramStyle(title: "Изумруд", tinted: true, accent: 0x4FE3A8, bubbles: [0x149A6B, 0x38C98F], wallpaper: [0x03140E, 0x0B3D2C, 0x06251B, 0x146B4C]),
+        GlassGramStyle(title: "Закат", tinted: true, accent: 0xFF8FA3, bubbles: [0xE0457B, 0xFF9A62], wallpaper: [0x1A0712, 0x4A1530, 0x2A0B1C, 0x7A2A3A]),
