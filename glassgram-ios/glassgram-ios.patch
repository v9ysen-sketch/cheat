+import Foundation
+
+/// GlassGram mod settings, stored in the app's standard user defaults.
+public enum GlassGramSettings {
+    private static let prefix = "glassgram."
+
+    private static func bool(_ key: String, _ defaultValue: Bool) -> Bool {
+        let defaults = UserDefaults.standard
+        if defaults.object(forKey: prefix + key) == nil {
+            return defaultValue
+        }
+        return defaults.bool(forKey: prefix + key)
+    }
+
+    private static func setBool(_ key: String, _ value: Bool) {
+        UserDefaults.standard.set(value, forKey: prefix + key)
+    }
+
+    private static func int(_ key: String, _ defaultValue: Int) -> Int {
+        let defaults = UserDefaults.standard
+        if defaults.object(forKey: prefix + key) == nil {
+            return defaultValue
+        }
+        return defaults.integer(forKey: prefix + key)
+    }
+
+    private static func setInt(_ key: String, _ value: Int) {
+        UserDefaults.standard.set(value, forKey: prefix + key)
+    }
+
+    // MARK: avatars
+
+    public static let avatarShapeCount = 5
+    public static let avatarShapeCircle = 4
+
+    /// 0 square, 1 almost square, 2 rounded (default), 3 soft, 4 circle.
+    public static var avatarShape: Int {
+        get {
+            return max(0, min(avatarShapeCount - 1, int("avatarShape", 2)))
+        }
+        set {
+            setInt("avatarShape", max(0, min(avatarShapeCount - 1, newValue)))
+        }
+    }
+
+    public static var squareAvatars: Bool {
+        return avatarShape != avatarShapeCircle
+    }
+
+    /// Corner radius of a square avatar as a fraction of its width (0.25 is Telegram's forum avatar).
+    public static var avatarCornerFactor: Double {
+        switch avatarShape {
+        case 0:
+            return 0.0
+        case 1:
+            return 0.08
+        case 2:
+            return 0.16
+        case 3:
+            return 0.3
+        default:
+            return 0.25
+        }
+    }
+
+    // MARK: style
+
+    /// Index into GlassGramStyles.presets.
+    public static var stylePreset: Int {
+        get {
+            return int("stylePreset", 0)
+        }
+        set {
+            setInt("stylePreset", newValue)
+        }
+    }
+
+    // MARK: interface
+
+    public static var hideStories: Bool {
+        get { return bool("hideStories", false) }
+        set { setBool("hideStories", newValue) }
+    }
+
+    public static var timeSeconds: Bool {
+        get { return bool("timeSeconds", false) }
+        set { setBool("timeSeconds", newValue) }
+    }
+
+    // MARK: ghost mode
+
+    public static var ghostRead: Bool {
+        get { return bool("ghostRead", false) }
+        set { setBool("ghostRead", newValue) }
+    }
+
+    public static var ghostStories: Bool {
+        get { return bool("ghostStories", false) }
+        set { setBool("ghostStories", newValue) }
+    }
+
+    public static var ghostOnline: Bool {
+        get { return bool("ghostOnline", false) }
+        set { setBool("ghostOnline", newValue) }
+    }
+
+    public static var ghostTyping: Bool {
+        get { return bool("ghostTyping", false) }
+        set { setBool("ghostTyping", newValue) }
+    }
+
+    // MARK: deleted messages
+
+    public static var saveDeleted: Bool {
+        get { return bool("saveDeleted", true) }
+        set { setBool("saveDeleted", newValue) }
+    }
+
+    public static var markDeleted: Bool {
+        get { return bool("markDeleted", true) }
+        set { setBool("markDeleted", newValue) }
+    }
+}
+
+/// Messages deleted on the server while "save deleted messages" is on. The messages stay in the local
+/// database (TelegramCore skips their deletion), this store keeps their ids for the "deleted" mark.
+/// Keys: channel id (0 for private chats and basic groups, whose message ids are per account) + message id.
+public final class GlassGramDeletedStore {
+    private static let lock = NSLock()
+    private static var loaded = false
+    private static var ids = Set<String>()
+    private static let defaultsKey = "glassgram.deletedMessages"
+
+    private static func loadIfNeeded() {
+        if !loaded {
+            ids = Set(UserDefaults.standard.stringArray(forKey: defaultsKey) ?? [])
+            loaded = true
+        }
+    }
+
+    public static func markDeleted(channelId: Int64, messageIds: [Int32]) {
+        if messageIds.isEmpty {
+            return
+        }
+        lock.lock()
+        loadIfNeeded()
+        for id in messageIds {
+            ids.insert("\(channelId)_\(id)")
+        }
+        let snapshot = Array(ids)
+        lock.unlock()
+        UserDefaults.standard.set(snapshot, forKey: defaultsKey)
+    }
+
+    public static func isDeleted(channelId: Int64, messageId: Int32) -> Bool {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        loadIfNeeded()
+        if ids.isEmpty {
+            return false
+        }
+        return ids.contains("\(channelId)_\(messageId)")
+    }
+
+    public static var count: Int {
+        lock.lock()
+        defer {
+            lock.unlock()
+        }
+        loadIfNeeded()
+        return ids.count
+    }
+
+    public static func clear() {
+        lock.lock()
+        ids.removeAll()
+        loaded = true
+        lock.unlock()
+        UserDefaults.standard.removeObject(forKey: defaultsKey)
+    }
+}
+
+/// Glass color styles: accent, outgoing bubble gradient and a 4-color gradient wallpaper of the dark theme.
+public struct GlassGramStyle {
+    public let title: String
+    /// true: the tinted dark theme (backgrounds follow the accent hue), false: the black night theme.
+    public let tinted: Bool
+    public let accent: UInt32
+    public let bubbles: [UInt32]
+    public let wallpaper: [UInt32]
+
+    public init(title: String, tinted: Bool, accent: UInt32, bubbles: [UInt32], wallpaper: [UInt32]) {
+        self.title = title
+        self.tinted = tinted
+        self.accent = accent
+        self.bubbles = bubbles
+        self.wallpaper = wallpaper
+    }
+}
