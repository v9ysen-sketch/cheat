+import TelegramUIPreferences
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import GlassGram
+import UniformTypeIdentifiers
+
+private enum GlassGramToggle: Equatable {
+    case hideStories
+    case timeSeconds
+    case ghostRead
+    case ghostStories
+    case ghostOnline
+    case ghostTyping
+    case saveDeleted
+    case markDeleted
+}
+
+private enum GlassGramAction: Equatable {
+    case clearDeleted
+    case installFromClipboard
+    case installFromFile
+}
+
+private final class GlassGramSettingsArguments {
+    let selectStyle: (Int) -> Void
+    let selectAvatarShape: (Int) -> Void
+    let toggle: (GlassGramToggle, Bool) -> Void
+    let action: (GlassGramAction) -> Void
+    let togglePlugin: (String, Bool) -> Void
+    let openPlugin: (String) -> Void
+
+    init(selectStyle: @escaping (Int) -> Void, selectAvatarShape: @escaping (Int) -> Void, toggle: @escaping (GlassGramToggle, Bool) -> Void, action: @escaping (GlassGramAction) -> Void, togglePlugin: @escaping (String, Bool) -> Void, openPlugin: @escaping (String) -> Void) {
+        self.selectStyle = selectStyle
+        self.selectAvatarShape = selectAvatarShape
+        self.toggle = toggle
+        self.action = action
+        self.togglePlugin = togglePlugin
+        self.openPlugin = openPlugin
+    }
+}
+
+private enum GlassGramSettingsSection: Int32 {
+    case style
+    case avatars
+    case interface
+    case ghost
+    case deleted
+    case plugins
+}
+
+private enum GlassGramSettingsEntry: ItemListNodeEntry {
+    case header(Int32, GlassGramSettingsSection, String)
+    case footer(Int32, GlassGramSettingsSection, String)
+    case style(Int32, Int, String, Bool)
+    case avatar(Int32, Int, String, Bool)
+    case toggle(Int32, GlassGramSettingsSection, GlassGramToggle, String, Bool, Bool)
+    case action(Int32, GlassGramSettingsSection, GlassGramAction, String, Bool)
+    case plugin(Int32, String, String, String?, Bool)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(_, section, _), let .footer(_, section, _), let .toggle(_, section, _, _, _, _), let .action(_, section, _, _, _):
+            return section.rawValue
+        case .style:
+            return GlassGramSettingsSection.style.rawValue
+        case .avatar:
+            return GlassGramSettingsSection.avatars.rawValue
+        case .plugin:
+            return GlassGramSettingsSection.plugins.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _, _), let .footer(id, _, _), let .style(id, _, _, _), let .avatar(id, _, _, _), let .toggle(id, _, _, _, _, _), let .action(id, _, _, _, _), let .plugin(id, _, _, _, _):
+            return id
+        }
+    }
+
+    static func <(lhs: GlassGramSettingsEntry, rhs: GlassGramSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! GlassGramSettingsArguments
+        switch self {
+        case let .header(_, _, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .footer(_, _, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .style(_, index, title, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.selectStyle(index)
+            })
+        case let .avatar(_, index, title, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.selectAvatarShape(index)
+            })
+        case let .toggle(_, _, kind, title, value, enabled):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, enabled: enabled, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle(kind, value)
+            })
+        case let .action(_, _, kind, title, destructive):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: destructive ? .destructive : .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.action(kind)
+            })
+        case let .plugin(_, pluginId, title, text, enabled):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, text: text, value: enabled, maximumNumberOfLines: 2, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.togglePlugin(pluginId, value)
+            }, action: {
+                arguments.openPlugin(pluginId)
+            })
+        }
+    }
+}
+
+private let glassGramAvatarShapeTitles: [String] = [
+    "Квадратные",
+    "Почти квадратные",
+    "Скруглённый квадрат",
+    "Мягкие",
+    "Круглые"
+]
+
+private func glassGramSettingsEntries() -> [GlassGramSettingsEntry] {
+    var entries: [GlassGramSettingsEntry] = []
+
+    entries.append(.header(0, .style, "СТИЛЬ СТЕКЛА"))
+    let currentStyle = GlassGramSettings.stylePreset
+    for (index, style) in GlassGramStyles.presets.enumerated() {
+        entries.append(.style(Int32(1 + index), index, style.title, index == currentStyle))
+    }
+    entries.append(.footer(99, .style, "Цвет акцентов, градиент исходящих сообщений и градиентные обои тёмной темы."))
+
+    entries.append(.header(100, .avatars, "ФОРМА АВАТАРОК"))
+    let currentShape = GlassGramSettings.avatarShape
+    for (index, title) in glassGramAvatarShapeTitles.enumerated() {
+        entries.append(.avatar(Int32(101 + index), index, title, index == currentShape))
+    }
+    entries.append(.footer(199, .avatars, "Полностью применится после перезапуска приложения."))
+
+    entries.append(.header(200, .interface, "ИНТЕРФЕЙС"))
+    entries.append(.toggle(201, .interface, .hideStories, "Скрыть истории над чатами", GlassGramSettings.hideStories, true))
+    entries.append(.toggle(202, .interface, .timeSeconds, "Время сообщений с секундами", GlassGramSettings.timeSeconds, true))
+
+    entries.append(.header(300, .ghost, "РЕЖИМ ПРИЗРАКА"))
+    entries.append(.toggle(301, .ghost, .ghostRead, "Не отправлять «прочитано»", GlassGramSettings.ghostRead, true))
+    entries.append(.toggle(302, .ghost, .ghostStories, "Смотреть истории незаметно", GlassGramSettings.ghostStories, true))
+    entries.append(.toggle(303, .ghost, .ghostOnline, "Всегда «не в сети»", GlassGramSettings.ghostOnline, true))
+    entries.append(.toggle(304, .ghost, .ghostTyping, "Не показывать «печатает…»", GlassGramSettings.ghostTyping, true))
+    entries.append(.footer(399, .ghost, "Собеседники не увидят, что вы прочитали сообщения или посмотрели истории."))
+
+    entries.append(.header(400, .deleted, "УДАЛЁННЫЕ СООБЩЕНИЯ"))
+    entries.append(.toggle(401, .deleted, .saveDeleted, "Сохранять удалённые сообщения", GlassGramSettings.saveDeleted, true))
+    entries.append(.toggle(402, .deleted, .markDeleted, "Помечать удалённые", GlassGramSettings.markDeleted, GlassGramSettings.saveDeleted))
+    let deletedCount = GlassGramDeletedStore.count
+    if deletedCount > 0 {
+        entries.append(.action(403, .deleted, .clearDeleted, "Забыть пометки удалённых (\(deletedCount))", true))
+    }
+    entries.append(.footer(499, .deleted, "Сообщения, которые удалил собеседник, остаются на этом устройстве с пометкой «удалено». Работает для сообщений, удалённых после включения."))
+
+    entries.append(.header(500, .plugins, "ПЛАГИНЫ (JAVASCRIPT)"))
+    var pluginIndex: Int32 = 0
+    for plugin in GlassGramPlugins.shared.list() {
+        var text: String? = plugin.description.isEmpty ? nil : plugin.description
+        if let error = plugin.error {
+            text = "Ошибка: " + error
+        }
+        entries.append(.plugin(501 + pluginIndex, plugin.id, plugin.name, text, plugin.enabled))
+        pluginIndex += 1
+    }
+    entries.append(.action(900, .plugins, .installFromClipboard, "Установить из буфера обмена", false))
+    entries.append(.action(901, .plugins, .installFromFile, "Установить из файла (.js)", false))
+    entries.append(.footer(999, .plugins, "Нажми на плагин, чтобы открыть его настройки или удалить. Плагин получает доступ к отправляемым и входящим сообщениям — ставь только те, которым доверяешь."))
+
+    return entries
+}
