@@ -0,0 +1,235 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TelegramUIPreferences
+import ItemListUI
+import PresentationDataUtils
+import AccountContext
+import GlassGram
+
+private enum GlassGramToggle: Equatable {
+    case hideStories
+    case timeSeconds
+    case ghostRead
+    case ghostStories
+    case ghostOnline
+    case ghostTyping
+    case saveDeleted
+    case markDeleted
+}
+
+private final class GlassGramSettingsArguments {
+    let selectStyle: (Int) -> Void
+    let selectAvatarShape: (Int) -> Void
+    let toggle: (GlassGramToggle, Bool) -> Void
+    let clearDeleted: () -> Void
+
+    init(selectStyle: @escaping (Int) -> Void, selectAvatarShape: @escaping (Int) -> Void, toggle: @escaping (GlassGramToggle, Bool) -> Void, clearDeleted: @escaping () -> Void) {
+        self.selectStyle = selectStyle
+        self.selectAvatarShape = selectAvatarShape
+        self.toggle = toggle
+        self.clearDeleted = clearDeleted
+    }
+}
+
+private enum GlassGramSettingsSection: Int32 {
+    case style
+    case avatars
+    case interface
+    case ghost
+    case deleted
+}
+
+private enum GlassGramSettingsEntry: ItemListNodeEntry {
+    case header(Int32, GlassGramSettingsSection, String)
+    case footer(Int32, GlassGramSettingsSection, String)
+    case style(Int32, Int, String, Bool)
+    case avatar(Int32, Int, String, Bool)
+    case toggle(Int32, GlassGramSettingsSection, GlassGramToggle, String, Bool, Bool)
+    case clearDeleted(Int32, String)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(_, section, _), let .footer(_, section, _), let .toggle(_, section, _, _, _, _):
+            return section.rawValue
+        case .style:
+            return GlassGramSettingsSection.style.rawValue
+        case .avatar:
+            return GlassGramSettingsSection.avatars.rawValue
+        case .clearDeleted:
+            return GlassGramSettingsSection.deleted.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _, _), let .footer(id, _, _), let .style(id, _, _, _), let .avatar(id, _, _, _), let .toggle(id, _, _, _, _, _), let .clearDeleted(id, _):
+            return id
+        }
+    }
+
+    static func <(lhs: GlassGramSettingsEntry, rhs: GlassGramSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! GlassGramSettingsArguments
+        switch self {
+        case let .header(_, _, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .footer(_, _, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case let .style(_, index, title, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.selectStyle(index)
+            })
+        case let .avatar(_, index, title, selected):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .left, checked: selected, zeroSeparatorInsets: false, sectionId: self.section, action: {
+                arguments.selectAvatarShape(index)
+            })
+        case let .toggle(_, _, kind, title, value, enabled):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, enabled: enabled, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.toggle(kind, value)
+            })
+        case let .clearDeleted(_, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.clearDeleted()
+            })
+        }
+    }
+}
+
+private let glassGramAvatarShapeTitles: [String] = [
+    "Квадратные",
+    "Почти квадратные",
+    "Скруглённый квадрат",
+    "Мягкие",
+    "Круглые"
+]
+
+private func glassGramSettingsEntries() -> [GlassGramSettingsEntry] {
+    var entries: [GlassGramSettingsEntry] = []
+
+    entries.append(.header(0, .style, "СТИЛЬ СТЕКЛА"))
+    let currentStyle = GlassGramSettings.stylePreset
+    for (index, style) in GlassGramStyles.presets.enumerated() {
+        entries.append(.style(Int32(1 + index), index, style.title, index == currentStyle))
+    }
+    entries.append(.footer(99, .style, "Цвет акцентов, градиент исходящих сообщений и градиентные обои тёмной темы."))
+
+    entries.append(.header(100, .avatars, "ФОРМА АВАТАРОК"))
+    let currentShape = GlassGramSettings.avatarShape
+    for (index, title) in glassGramAvatarShapeTitles.enumerated() {
+        entries.append(.avatar(Int32(101 + index), index, title, index == currentShape))
+    }
+    entries.append(.footer(199, .avatars, "Полностью применится после перезапуска приложения."))
+
+    entries.append(.header(200, .interface, "ИНТЕРФЕЙС"))
+    entries.append(.toggle(201, .interface, .hideStories, "Скрыть истории над чатами", GlassGramSettings.hideStories, true))
+    entries.append(.toggle(202, .interface, .timeSeconds, "Время сообщений с секундами", GlassGramSettings.timeSeconds, true))
+
+    entries.append(.header(300, .ghost, "РЕЖИМ ПРИЗРАКА"))
+    entries.append(.toggle(301, .ghost, .ghostRead, "Не отправлять «прочитано»", GlassGramSettings.ghostRead, true))
+    entries.append(.toggle(302, .ghost, .ghostStories, "Смотреть истории незаметно", GlassGramSettings.ghostStories, true))
+    entries.append(.toggle(303, .ghost, .ghostOnline, "Всегда «не в сети»", GlassGramSettings.ghostOnline, true))
+    entries.append(.toggle(304, .ghost, .ghostTyping, "Не показывать «печатает…»", GlassGramSettings.ghostTyping, true))
+    entries.append(.footer(399, .ghost, "Собеседники не увидят, что вы прочитали сообщения или посмотрели истории."))
+
+    entries.append(.header(400, .deleted, "УДАЛЁННЫЕ СООБЩЕНИЯ"))
+    entries.append(.toggle(401, .deleted, .saveDeleted, "Сохранять удалённые сообщения", GlassGramSettings.saveDeleted, true))
+    entries.append(.toggle(402, .deleted, .markDeleted, "Помечать удалённые", GlassGramSettings.markDeleted, GlassGramSettings.saveDeleted))
+    let deletedCount = GlassGramDeletedStore.count
+    if deletedCount > 0 {
+        entries.append(.clearDeleted(403, "Забыть пометки удалённых (\(deletedCount))"))
+    }
+    entries.append(.footer(499, .deleted, "Сообщения, которые удалил собеседник, остаются на этом устройстве с пометкой «удалено». Работает для сообщений, удалённых после включения."))
+
+    return entries
+}
+
+private func glassGramApplyStyle(context: AccountContext, index: Int) {
+    let presets = GlassGramStyles.presets
+    if index < 0 || index >= presets.count {
+        return
+    }
+    let style = presets[index]
+    GlassGramSettings.stylePreset = index
+    let reference: PresentationThemeReference = .builtin(style.tinted ? .nightAccent : .night)
+    let wallpaper = defaultBuiltinWallpaper(data: .default, colors: style.wallpaper, intensity: -35, rotation: nil)
+    let accent = PresentationThemeAccentColor(index: Int32(900 + index), baseColor: .custom, accentColor: 0xFF000000 | style.accent, bubbleColors: style.bubbles.map { 0xFF000000 | $0 }, wallpaper: wallpaper)
+    let _ = updatePresentationThemeSettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+        var accentColors = settings.themeSpecificAccentColors
+        accentColors[reference.index] = accent
+        let automatic = AutomaticThemeSwitchSetting(force: settings.automaticThemeSwitchSetting.force, trigger: settings.automaticThemeSwitchSetting.trigger, theme: reference)
+        return settings
+            .withUpdatedTheme(reference)
+            .withUpdatedThemeSpecificAccentColors(accentColors)
+            .withUpdatedThemeSpecificChatWallpapers([:])
+            .withUpdatedAutomaticThemeSwitchSetting(automatic)
+    }).start()
+}
+
+public func glassGramSettingsController(context: AccountContext) -> ViewController {
+    let updatePromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    let reload: () -> Void = {
+        counter += 1
+        updatePromise.set(counter)
+    }
+
+    let arguments = GlassGramSettingsArguments(
+        selectStyle: { index in
+            glassGramApplyStyle(context: context, index: index)
+            reload()
+        },
+        selectAvatarShape: { index in
+            GlassGramSettings.avatarShape = index
+            reload()
+        },
+        toggle: { kind, value in
+            switch kind {
+            case .hideStories:
+                GlassGramSettings.hideStories = value
+            case .timeSeconds:
+                GlassGramSettings.timeSeconds = value
+            case .ghostRead:
+                GlassGramSettings.ghostRead = value
+            case .ghostStories:
+                GlassGramSettings.ghostStories = value
+            case .ghostOnline:
+                GlassGramSettings.ghostOnline = value
+            case .ghostTyping:
+                GlassGramSettings.ghostTyping = value
+            case .saveDeleted:
+                GlassGramSettings.saveDeleted = value
+            case .markDeleted:
+                GlassGramSettings.markDeleted = value
+            }
+            reload()
+        },
+        clearDeleted: {
+            GlassGramDeletedStore.clear()
+            reload()
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        updatePromise.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        let updatedTheme = presentationData.theme.withModalBlocksBackground()
+        presentationData = presentationData.withUpdated(theme: updatedTheme)
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("GlassGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: glassGramSettingsEntries(), style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    return controller
+}
