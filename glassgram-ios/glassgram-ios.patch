+private func glassGramApplyStyle(context: AccountContext, index: Int) {
+    let presets = GlassGramStyles.presets
+    if index < 0 || index >= presets.count {
+        return
+    }
+    let style = presets[index]
+    GlassGramSettings.stylePreset = index
+    let reference: PresentationThemeReference = .builtin(style.tinted ? .nightAccent : .night)
+    let wallpaper = defaultBuiltinWallpaper(data: .default, colors: style.wallpaper, intensity: -35, rotation: nil)
+    let accent = PresentationThemeAccentColor(index: Int32(900 + index), baseColor: .custom, accentColor: 0xFF000000 | style.accent, bubbleColors: style.bubbles.map { 0xFF000000 | $0 }, wallpaper: wallpaper)
+    let _ = updatePresentationThemeSettingsInteractively(accountManager: context.sharedContext.accountManager, { settings in
+        var accentColors = settings.themeSpecificAccentColors
+        accentColors[reference.index] = accent
+        let automatic = AutomaticThemeSwitchSetting(force: settings.automaticThemeSwitchSetting.force, trigger: settings.automaticThemeSwitchSetting.trigger, theme: reference)
+        return settings
+            .withUpdatedTheme(reference)
+            .withUpdatedThemeSpecificAccentColors(accentColors)
+            .withUpdatedThemeSpecificChatWallpapers([:])
+            .withUpdatedAutomaticThemeSwitchSetting(automatic)
+    }).start()
+}
+
+public func glassGramSettingsController(context: AccountContext) -> ViewController {
+    weak var controllerRef: ViewController?
+    let updatePromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    let reload: () -> Void = {
+        counter += 1
+        updatePromise.set(counter)
+    }
+
+    let arguments = GlassGramSettingsArguments(
+        selectStyle: { index in
+            glassGramApplyStyle(context: context, index: index)
+            reload()
+        },
+        selectAvatarShape: { index in
+            GlassGramSettings.avatarShape = index
+            reload()
+        },
+        toggle: { kind, value in
+            switch kind {
+            case .hideStories:
+                GlassGramSettings.hideStories = value
+            case .timeSeconds:
+                GlassGramSettings.timeSeconds = value
+            case .ghostRead:
+                GlassGramSettings.ghostRead = value
+            case .ghostStories:
+                GlassGramSettings.ghostStories = value
+            case .ghostOnline:
+                GlassGramSettings.ghostOnline = value
+            case .ghostTyping:
+                GlassGramSettings.ghostTyping = value
+            case .saveDeleted:
+                GlassGramSettings.saveDeleted = value
+            case .markDeleted:
+                GlassGramSettings.markDeleted = value
+            }
+            reload()
+        },
+        action: { kind in
+            switch kind {
+            case .clearDeleted:
+                GlassGramDeletedStore.clear()
+                reload()
+            case .installFromClipboard:
+                glassGramInstallPlugin(source: UIPasteboard.general.string, controller: controllerRef, completion: reload)
+            case .installFromFile:
+                guard let controller = controllerRef else {
+                    return
+                }
+                let picker = UIDocumentPickerViewController(forOpeningContentTypes: [UTType.javaScript, UTType.plainText, UTType.data], asCopy: true)
+                let delegate = GlassGramDocumentPickerDelegate(completion: { [weak controller] url in
+                    let source = url.flatMap { try? String(contentsOf: $0, encoding: .utf8) }
+                    glassGramInstallPlugin(source: source, controller: controller, completion: reload)
+                })
+                picker.delegate = delegate
+                controller.present(picker, animated: true, completion: nil)
+            }
+        },
+        togglePlugin: { pluginId, value in
+            GlassGramPlugins.shared.setEnabled(id: pluginId, enabled: value)
+            reload()
+        },
+        openPlugin: { pluginId in
+            guard let controller = controllerRef else {
+                return
+            }
+            let name = GlassGramPlugins.shared.list().first(where: { $0.id == pluginId })?.name ?? pluginId
+            controller.push(glassGramPluginController(context: context, pluginId: pluginId, name: name, changed: reload))
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        updatePromise.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        let updatedTheme = presentationData.theme.withModalBlocksBackground()
+        presentationData = presentationData.withUpdated(theme: updatedTheme)
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("GlassGram"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: glassGramSettingsEntries(), style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    controllerRef = controller
+    return controller
+}
+
+
+/// Keeps itself alive until the picker reports back (the picker holds its delegate weakly).
+private final class GlassGramDocumentPickerDelegate: NSObject, UIDocumentPickerDelegate {
+    private let completion: (URL?) -> Void
+    private var keepAlive: GlassGramDocumentPickerDelegate?
+
+    init(completion: @escaping (URL?) -> Void) {
+        self.completion = completion
+        super.init()
+        self.keepAlive = self
+    }
+
+    func documentPicker(_ controller: UIDocumentPickerViewController, didPickDocumentsAt urls: [URL]) {
+        self.completion(urls.first)
+        self.keepAlive = nil
+    }
+
+    func documentPickerWasCancelled(_ controller: UIDocumentPickerViewController) {
+        self.keepAlive = nil
+    }
+}
+
+private func glassGramShowAlert(controller: ViewController?, title: String, text: String) {
+    guard let controller else {
+        return
+    }
+    let alert = UIAlertController(title: title, message: text, preferredStyle: .alert)
+    alert.addAction(UIAlertAction(title: "OK", style: .default, handler: nil))
+    controller.present(alert, animated: true, completion: nil)
+}
+
+private func glassGramInstallPlugin(source: String?, controller: ViewController?, completion: @escaping () -> Void) {
+    guard let source, !source.isEmpty else {
+        glassGramShowAlert(controller: controller, title: "Плагин", text: "Нет текста плагина. Скопируй код плагина (.js) и попробуй снова.")
+        return
+    }
+    do {
+        let id = try GlassGramPlugins.shared.install(source: source)
+        glassGramShowAlert(controller: controller, title: "Плагин установлен", text: "Плагин «\(id)» установлен и включён.")
+    } catch {
+        glassGramShowAlert(controller: controller, title: "Не удалось установить", text: error.localizedDescription)
+    }
+    completion()
+}
+
+// MARK: plugin screen
+
+private enum GlassGramPluginEntry: ItemListNodeEntry {
+    case header(Int32, String)
+    case toggle(Int32, String, String, Bool)
+    case input(Int32, String, String, String)
+    case text(Int32, String)
+    case delete(Int32)
+
+    var section: ItemListSectionId {
+        switch self {
+        case .delete:
+            return 1
+        default:
+            return 0
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case let .header(id, _), let .toggle(id, _, _, _), let .input(id, _, _, _), let .text(id, _), let .delete(id):
+            return id
+        }
+    }
+
+    static func <(lhs: GlassGramPluginEntry, rhs: GlassGramPluginEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! GlassGramPluginArguments
+        switch self {
+        case let .header(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .toggle(_, key, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.setValue(key, value ? "true" : "false")
+            })
+        case let .input(_, key, title, value):
+            return ItemListDisclosureItem(presentationData: presentationData, systemStyle: .glass, title: title, label: value, labelStyle: .text, sectionId: self.section, style: .blocks, disclosureStyle: .arrow, action: {
+                arguments.edit(key, title, value)
+            })
+        case let .text(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        case .delete:
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: "Удалить плагин", kind: .destructive, alignment: .natural, sectionId: self.section, style: .blocks, action: {
+                arguments.delete()
+            })
+        }
+    }
+}
+
+private final class GlassGramPluginArguments {
+    let setValue: (String, String) -> Void
+    let edit: (String, String, String) -> Void
+    let delete: () -> Void
+
+    init(setValue: @escaping (String, String) -> Void, edit: @escaping (String, String, String) -> Void, delete: @escaping () -> Void) {
+        self.setValue = setValue
+        self.edit = edit
+        self.delete = delete
+    }
+}
+
+private func glassGramPluginEntries(pluginId: String) -> [GlassGramPluginEntry] {
+    var entries: [GlassGramPluginEntry] = []
+    let info = GlassGramPlugins.shared.list().first(where: { $0.id == pluginId })
+    var index: Int32 = 0
+    for item in GlassGramPlugins.shared.settings(id: pluginId) {
+        index += 1
+        switch item.kind {
+        case "header":
+            entries.append(.header(index, item.title.uppercased()))
+        case "switch":
+            entries.append(.toggle(index, item.key, item.title, item.isOn))
+        case "input":
+            entries.append(.input(index, item.key, item.title, item.value))
+        default:
+            entries.append(.text(index, item.title))
+        }
+    }
+    var about: [String] = []
+    if let info {
+        if !info.description.isEmpty {
+            about.append(info.description)
+        }
+        about.append("id: \(info.id) · версия \(info.version)")
+        if let error = info.error {
+            about.append("Ошибка: " + error)
+        }
+    }
+    entries.append(.text(1000, about.joined(separator: "\n")))
+    entries.append(.delete(1001))
+    return entries
+}
+
+private func glassGramPluginController(context: AccountContext, pluginId: String, name: String, changed: @escaping () -> Void) -> ViewController {
+    weak var controllerRef: ViewController?
+    let updatePromise = ValuePromise<Int>(0, ignoreRepeated: false)
+    var counter = 0
+    let reload: () -> Void = {
+        counter += 1
+        updatePromise.set(counter)
+        changed()
+    }
+
+    let arguments = GlassGramPluginArguments(
+        setValue: { key, value in
+            GlassGramPlugins.shared.setSetting(id: pluginId, key: key, value: value)
+            reload()
+        },
+        edit: { key, title, value in
+            guard let controller = controllerRef else {
+                return
+            }
+            let alert = UIAlertController(title: title, message: nil, preferredStyle: .alert)
+            alert.addTextField { textField in
+                textField.text = value
+                textField.clearButtonMode = .whileEditing
+            }
+            alert.addAction(UIAlertAction(title: "Отмена", style: .cancel, handler: nil))
+            alert.addAction(UIAlertAction(title: "Сохранить", style: .default, handler: { [weak alert] _ in
+                let text = alert?.textFields?.first?.text ?? ""
+                GlassGramPlugins.shared.setSetting(id: pluginId, key: key, value: text)
+                reload()
+            }))
+            controller.present(alert, animated: true, completion: nil)
+        },
+        delete: {
+            GlassGramPlugins.shared.delete(id: pluginId)
+            changed()
+            controllerRef?.dismiss()
+        }
+    )
+
+    let signal = combineLatest(queue: .mainQueue(),
+        context.sharedContext.presentationData,
+        updatePromise.get()
+    )
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var presentationData = presentationData
+        let updatedTheme = presentationData.theme.withModalBlocksBackground()
+        presentationData = presentationData.withUpdated(theme: updatedTheme)
+
+        let controllerState = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text(name), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        let listState = ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: glassGramPluginEntries(pluginId: pluginId), style: .blocks, animateChanges: true)
+        return (controllerState, (listState, arguments))
+    }
+
+    let controller = ItemListController(context: context, state: signal)
+    controllerRef = controller
+    return controller
+}
