+        GlassGramStyle(title: "Розовое стекло", tinted: true, accent: 0xFF7AC6, bubbles: [0xD9408F, 0xFF7FB8], wallpaper: [0x1A0614, 0x4A1238, 0x2A0A20, 0x7A1F5C]),
+        GlassGramStyle(title: "Рубин", tinted: true, accent: 0xFF6B6B, bubbles: [0xC9302C, 0xFF6A5C], wallpaper: [0x1A0505, 0x4A0F12, 0x2A0809, 0x7A1A1F]),
+        GlassGramStyle(title: "Апельсин", tinted: true, accent: 0xFFA94D, bubbles: [0xE0701F, 0xFFB15C], wallpaper: [0x1A0E03, 0x4A2A0B, 0x2A1806, 0x7A4514]),
